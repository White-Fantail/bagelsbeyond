// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── User & Role ──────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile         CustomerProfile?
  subscriptions           Subscription[]
  bagelAvailabilityStates BagelAvailabilityState[]

  @@map("users")
}

// ─── Customer Profile ─────────────────────────────────────────────────────────
// 1:1 extension of User for CUSTOMER-specific data.
// Designed to hold order/subscription/address data in future phases.

model CustomerProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  phone                String?
  preferredPickupNote  String?
  marketingOptIn       Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model DailyRecord {
  id             String   @id @default(cuid())
  date           DateTime @unique
  bagelsBaked    Int
  bagelsLeft     Int
  storeSales     Float
  uberSales      Float
  doordashSales  Float
  otherSales     Float
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  externalFactor DailyExternalFactor?

  @@map("daily_records")
}

model DailyExternalFactor {
  id               String    @id @default(cuid())
  date             DateTime  @unique
  dailyRecordId    String?   @unique
  weatherSummary   String?
  minTemp          Float?
  maxTemp          Float?
  rainMm           Float?
  windKph          Float?
  holidayName      String?
  localEventName   String?
  schoolHoliday    Boolean   @default(false)
  nzNewsSummary    String?
  worldNewsSummary String?
  sourceWeather    String?
  sourceHoliday    String?
  sourceEvents     String?
  sourceNews       String?
  collectedAt      DateTime?
  lastRefreshedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  dailyRecord      DailyRecord? @relation(fields: [dailyRecordId], references: [id], onDelete: SetNull)

  @@index([date])
  @@map("daily_external_factors")
}

model PredictionWeight {
  id          String  @id @default(cuid())
  factorKey   String  @unique
  weightValue Float
  isActive    Boolean @default(true)
  description String?

  @@map("prediction_weights")
}

model AppSetting {
  id                      String   @id @default(cuid())
  shopName                String   @default("Bagels Beyond")
  defaultTargetWasteRatio Float    @default(0.05)
  defaultSafetyBuffer     Float    @default(1.1)
  defaultRegion           String   @default("Canterbury")
  defaultCity             String   @default("Christchurch")
  defaultCountry          String   @default("NZ")
  defaultEventRegion      String   @default("Christchurch")
  autoCollectExternalData Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("app_settings")
}

model SalesPrediction {
  id                       String   @id @default(cuid())
  targetDate               DateTime
  predictedSales           Float
  predictedBagelsSold      Int
  recommendedBagelsToBake  Int
  predictedLeftovers       Int
  confidenceScore          Float?
  method                   String   @default("rule_based_v2")
  notes                    String?
  // Extended fields for advanced prediction
  projectedWasteRate       Float?
  projectedSellThroughRate Float?
  baselineSales            Float?
  baselineBagelsSold       Int?
  adjustmentSummary        String?
  explanationJson          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  factorSnapshots PredictionFactorSnapshot[]

  @@index([targetDate])
  @@map("sales_predictions")
}

model PredictionFactorSnapshot {
  id                 String          @id @default(cuid())
  salesPredictionId  String
  factorKey          String
  factorLabel        String
  factorValue        String
  appliedWeight      Float
  impactScore        Float
  createdAt          DateTime        @default(now())

  salesPrediction    SalesPrediction @relation(fields: [salesPredictionId], references: [id], onDelete: Cascade)

  @@map("prediction_factor_snapshots")
}

model ImportJob {
  id           String   @id @default(cuid())
  fileName     String
  status       String   @default("pending") // pending, validating, ready, imported, failed
  totalRows    Int      @default(0)
  successRows  Int      @default(0)
  failedRows   Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rows ImportRow[]

  @@map("import_jobs")
}

model ImportRow {
  id                   String    @id @default(cuid())
  jobId                String
  rowNumber            Int
  rawJson              String
  parsedDate           DateTime?
  parsedBagelsBaked    Int?
  parsedBagelsLeft     Int?
  parsedStoreSales     Float?
  parsedUberSales      Float?
  parsedDoordashSales  Float?
  parsedOtherSales     Float?
  parsedNotes          String?
  status               String    @default("pending") // pending, valid, invalid, imported, skipped
  linkedDailyRecordId  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("import_rows")
}

// ─── Background Task Management ───────────────────────────────────────────────

model ScheduledTask {
  id            String    @id @default(cuid())
  taskType      String    // collect_external_factors | generate_prediction
  targetDate    DateTime?
  status        String    @default("pending") // pending | running | success | partial | failed | skipped
  startedAt     DateTime?
  finishedAt    DateTime?
  errorMessage  String?
  resultSummary String?
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  logs          TaskLog[]

  @@index([status])
  @@index([taskType, targetDate])
  @@index([targetDate])
  @@map("scheduled_tasks")
}

model TaskLog {
  id              String        @id @default(cuid())
  scheduledTaskId String
  message         String
  level           String        @default("info") // info | warning | error
  createdAt       DateTime      @default(now())

  task            ScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)

  @@index([scheduledTaskId])
  @@map("task_logs")
}

// ─── Admin Audit Log ──────────────────────────────────────────────────────────
// Records admin actions on user accounts for auditability.
// Extensible for future actions (e.g. password resets, invites).
// Future extension: add a UI in /admin/audit-logs to view these records.
// Future extension: lastLoginAt can be tracked by updating the User model on each login.

model AdminActionLog {
  id            String   @id @default(cuid())
  adminUserId   String   // The ADMIN who performed the action
  targetUserId  String   // The user whose account was affected
  actionType    String   // CHANGE_ROLE | ACTIVATE_USER | DEACTIVATE_USER
  previousValue String   // Previous role or isActive value (stringified)
  newValue      String   // New role or isActive value (stringified)
  createdAt     DateTime @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("admin_action_logs")
}

// ─── Order ────────────────────────────────────────────────────────────────────

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
  DINE_IN
}

enum OrderSource {
  INTERNAL
  SUBSCRIPTION
  POS_IMPORTED
}

enum IntegrationSource {
  LOYVERSE
  SQUARE
  OTHER
}

model Order {
  id                    String          @id @default(cuid())
  orderNumber           String          @unique
  userId                String?
  status                OrderStatus     @default(DRAFT)
  paymentStatus         PaymentStatus   @default(UNPAID)
  fulfillmentType       FulfillmentType @default(PICKUP)
  pickupDate            DateTime?       @db.Date
  pickupTimeSlot        String?
  customerNameSnapshot  String?
  customerEmailSnapshot String?
  customerPhoneSnapshot String?
  subtotalAmount        Float           @default(0)
  discountAmount        Float           @default(0)
  totalAmount           Float           @default(0)
  note                  String?
  source                OrderSource     @default(INTERNAL)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  items                  OrderItem[]
  externalMapping        ExternalOrderMap?
  subscriptionOccurrence SubscriptionOccurrence?

  @@index([status])
  @@index([userId])
  @@index([pickupDate])
  @@index([source])
  @@map("orders")
}

model ExternalOrderMap {
  id               String            @id @default(cuid())
  source           IntegrationSource
  orderId          String            @unique
  externalOrderId  String?
  syncStatus       String            @default("pending")
  lastSyncedAt     DateTime?
  errorMessage     String?
  requestSummary   String?
  responseSummary  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([source, externalOrderId])
  @@index([syncStatus])
  @@map("external_order_maps")
}

model OrderItem {
  id                   String           @id @default(cuid())
  orderId              String
  productNameSnapshot  String
  unitPriceSnapshot    Float
  quantity             Int
  lineTotal            Float
  note                 String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  order                Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  options              OrderItemOption[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemOption {
  id                      String         @id @default(cuid())
  orderItemId             String
  optionGroupNameSnapshot String
  optionNameSnapshot      String
  priceDeltaSnapshot      Float          @default(0)
  quantity                Int            @default(1)
  createdAt               DateTime       @default(now())

  orderItem               OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_options")
}

// ─── Subscription ─────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum OccurrenceStatus {
  SCHEDULED
  ORDER_CREATED
  SKIPPED
  CANCELLED
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  status          SubscriptionStatus @default(ACTIVE)
  pickupWeekday   Int
  pickupTimeSlot  String?
  startDate       DateTime           @db.Date
  endDate         DateTime?          @db.Date
  note            String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           SubscriptionItem[]
  occurrences     SubscriptionOccurrence[]

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionItem {
  id             String       @id @default(cuid())
  subscriptionId String
  itemId         String?
  quantity       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  item           Item?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  options        SubscriptionItemOption[]

  @@index([subscriptionId])
  @@map("subscription_items")
}

model SubscriptionItemOption {
  id                      String           @id @default(cuid())
  subscriptionItemId      String
  optionGroupNameSnapshot String
  optionNameSnapshot      String
  priceDeltaSnapshot      Float            @default(0)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  subscriptionItem        SubscriptionItem @relation(fields: [subscriptionItemId], references: [id], onDelete: Cascade)

  @@index([subscriptionItemId])
  @@map("subscription_item_options")
}

model SubscriptionOccurrence {
  id             String           @id @default(cuid())
  subscriptionId String
  date           DateTime         @db.Date
  status         OccurrenceStatus @default(SCHEDULED)
  orderId        String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  subscription   Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([subscriptionId, date])
  @@index([date])
  @@index([status])
  @@map("subscription_occurrences")
}

// ─── Bagel Type Availability Control ─────────────────────────────────────────

enum BagelChangeSource {
  manual
  voice
  sync
  system
  api

  @@map("bagel_change_source")
}

enum AvailabilityChannel {
  loyverse
  uber_eats
  doordash

  @@map("availability_channel")
}

enum ChannelSyncResult {
  success
  failed
  pending
  skipped

  @@map("channel_sync_result")
}

enum AvailabilityAuditAction {
  turned_on
  turned_off
  retried
  restored

  @@map("availability_audit_action")
}

enum RemoteEntityType {
  item
  option
  modifier_option
  category_item
  unknown

  @@map("remote_entity_type")
}

enum SyncJobStatus {
  pending
  processing
  success
  failed

  @@map("sync_job_status")
}

model BagelType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilityStates  BagelAvailabilityState[]
  channelSyncStatuses ChannelSyncStatus[]
  channelMappings     ChannelBagelMapping[]
  auditLogs           AvailabilityAuditLog[]
  syncJobs            AvailabilitySyncJob[]

  @@index([code])
  @@index([sortOrder])
  @@map("bagel_types")
}

model BagelAvailabilityState {
  id              String            @id @default(cuid())
  bagelTypeId     String
  isAvailable     Boolean
  changedByUserId String?
  changeSource    BagelChangeSource @default(manual)
  note            String?
  createdAt       DateTime          @default(now())

  bagelType     BagelType @relation(fields: [bagelTypeId], references: [id], onDelete: Cascade)
  changedByUser User?     @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([bagelTypeId, createdAt(sort: Desc)])
  @@map("bagel_availability_states")
}

model ChannelSyncStatus {
  id                   String              @id @default(cuid())
  bagelTypeId          String
  channel              AvailabilityChannel
  lastAttemptAt        DateTime?
  lastSuccessAt        DateTime?
  lastResult           ChannelSyncResult   @default(pending)
  lastError            String?
  lastKnownRemoteState Boolean?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  bagelType BagelType @relation(fields: [bagelTypeId], references: [id], onDelete: Cascade)

  @@unique([bagelTypeId, channel])
  @@index([bagelTypeId])
  @@map("channel_sync_statuses")
}

model ChannelBagelMapping {
  id               String              @id @default(cuid())
  bagelTypeId      String
  channel          AvailabilityChannel
  remoteEntityType RemoteEntityType    @default(unknown)
  remoteEntityId   String
  remoteMenuId     String?
  remoteStoreId    String?
  metadata         Json?
  isEnabled        Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  bagelType BagelType @relation(fields: [bagelTypeId], references: [id], onDelete: Cascade)

  @@unique([bagelTypeId, channel, remoteEntityId])
  @@index([bagelTypeId, channel])
  @@map("channel_bagel_mappings")
}

model AvailabilityAuditLog {
  id          String                  @id @default(cuid())
  bagelTypeId String
  action      AvailabilityAuditAction
  source      BagelChangeSource
  actorUserId String?
  actorLabel  String?
  details     Json?
  createdAt   DateTime                @default(now())

  bagelType BagelType @relation(fields: [bagelTypeId], references: [id], onDelete: Cascade)

  @@index([bagelTypeId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("availability_audit_logs")
}

model AvailabilitySyncJob {
  id              String              @id @default(cuid())
  bagelTypeId     String
  channel         AvailabilityChannel
  targetState     Boolean
  status          SyncJobStatus       @default(pending)
  retryCount      Int                 @default(0)
  maxRetries      Int                 @default(3)
  nextRetryAt     DateTime?
  lastError       String?
  requestPayload  Json?
  responsePayload Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  bagelType BagelType @relation(fields: [bagelTypeId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([bagelTypeId])
  @@map("availability_sync_jobs")
}

// ─── ARCHITECTURE NOTE ────────────────────────────────────────────────────────
// Internal canonical tables: service source-of-truth. No external IDs stored here.
// Channel mirror tables:      channel_ prefix. Mirrors upstream external data.
// Mapping tables:             *_channel_mappings. Connects internal ↔ channel.
// Rule: external API calls MUST use mapped external IDs, never internal IDs.
// ─────────────────────────────────────────────────────────────────────────────

enum Channel {
  LOYVERSE
  UBER
  DOORDASH
}

enum MappingStatus {
  ACTIVE
  UNMAPPED
  ERROR
  DISABLED
}

// ─── Internal Canonical Tables ────────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  name        String
  color       String?
  sortOrder   Int      @default(0)
  isVisible   Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items                   Item[]
  categoryChannelMappings CategoryChannelMapping[]

  @@index([isActive])
  @@map("categories")
}

model Item {
  id             String   @id @default(cuid())
  categoryId     String?
  name           String
  description    String?
  sku            String?
  basePrice      Decimal? @db.Decimal(10, 2)
  trackStock     Boolean  @default(false)
  soldByWeight   Boolean  @default(false)
  isComposite    Boolean  @default(false)
  useProduction  Boolean  @default(false)
  form           String?
  color          String?
  imageUrl       String?
  sortOrder      Int      @default(0)
  isVisible      Boolean  @default(true)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category            Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants            ItemVariant[]
  itemModifierGroups  ItemModifierGroup[]
  itemChannelMappings ItemChannelMapping[]
  subscriptionItems   SubscriptionItem[]

  @@index([categoryId])
  @@index([isActive])
  @@map("items")
}

model ItemVariant {
  id              String   @id @default(cuid())
  itemId          String
  name            String
  sku             String?
  barcode         String?
  price           Decimal? @db.Decimal(10, 2)
  cost            Decimal? @db.Decimal(10, 2)
  purchaseCost    Decimal? @db.Decimal(10, 2)
  option1Value    String?
  option2Value    String?
  option3Value    String?
  sortOrder       Int      @default(0)
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item                       Item                       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemVariantChannelMappings ItemVariantChannelMapping[]

  @@index([itemId])
  @@map("item_variants")
}

model ModifierGroup {
  id          String   @id @default(cuid())
  name        String
  description String?
  minSelect   Int?
  maxSelect   Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modifierOptions              ModifierOption[]
  itemModifierGroups           ItemModifierGroup[]
  modifierGroupChannelMappings ModifierGroupChannelMapping[]

  @@index([isActive])
  @@map("modifier_groups")
}

model ModifierOption {
  id              String   @id @default(cuid())
  modifierGroupId String
  name            String
  priceDelta      Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder       Int      @default(0)
  isDefault       Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  modifierGroup                 ModifierGroup                 @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  modifierOptionChannelMappings ModifierOptionChannelMapping[]

  @@index([modifierGroupId])
  @@map("modifier_options")
}

model ItemModifierGroup {
  id              String   @id @default(cuid())
  itemId          String
  modifierGroupId String
  sortOrder       Int      @default(0)
  isRequired      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  item          Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([itemId, modifierGroupId])
  @@index([itemId])
  @@index([modifierGroupId])
  @@map("item_modifier_groups")
}

// ─── Channel Mirror Tables ────────────────────────────────────────────────────

model ChannelCategory {
  id                String    @id @default(cuid())
  channel           Channel
  externalId        String
  name              String
  color             String?
  externalCreatedAt DateTime?
  externalUpdatedAt DateTime?
  externalDeletedAt DateTime?
  rawPayload        Json
  syncedAt          DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  channelItems            ChannelItem[]
  categoryChannelMappings CategoryChannelMapping[]

  @@unique([channel, externalId])
  @@index([channel, externalId])
  @@index([syncedAt])
  @@map("channel_categories")
}

model ChannelItem {
  id                   String    @id @default(cuid())
  channel              Channel
  externalId           String
  channelCategoryId    String?
  handle               String?
  itemName             String
  description          String?
  referenceId          String?
  trackStock           Boolean   @default(false)
  soldByWeight         Boolean   @default(false)
  isComposite          Boolean   @default(false)
  useProduction        Boolean   @default(false)
  primarySupplierId    String?
  form                 String?
  color                String?
  imageUrl             String?
  option1Name          String?
  option2Name          String?
  option3Name          String?
  externalCreatedAt    DateTime?
  externalUpdatedAt    DateTime?
  externalDeletedAt    DateTime?
  rawPayload           Json
  syncedAt             DateTime
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  channelCategory               ChannelCategory?               @relation(fields: [channelCategoryId], references: [id], onDelete: SetNull)
  channelVariants               ChannelVariant[]
  channelItemComponents         ChannelItemComponent[]
  channelItemTaxLinks           ChannelItemTaxLink[]
  channelItemModifierGroupLinks ChannelItemModifierGroupLink[]
  itemChannelMappings           ItemChannelMapping[]

  @@unique([channel, externalId])
  @@index([channel, externalId])
  @@index([syncedAt])
  @@map("channel_items")
}

model ChannelItemComponent {
  id                       String   @id @default(cuid())
  channel                  Channel
  channelItemId            String
  channelVariantExternalId String
  quantity                 Decimal  @db.Decimal(10, 4)
  rawPayload               Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  channelItem ChannelItem @relation(fields: [channelItemId], references: [id], onDelete: Cascade)

  @@index([channelItemId])
  @@map("channel_item_components")
}

model ChannelItemTaxLink {
  id             String   @id @default(cuid())
  channel        Channel
  channelItemId  String
  taxExternalId  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  channelItem ChannelItem @relation(fields: [channelItemId], references: [id], onDelete: Cascade)

  @@unique([channel, channelItemId, taxExternalId])
  @@index([channelItemId])
  @@map("channel_item_tax_links")
}

model ChannelItemModifierGroupLink {
  id                             String   @id @default(cuid())
  channel                        Channel
  channelItemId                  String
  channelModifierGroupExternalId String
  createdAt                      DateTime @default(now())
  updatedAt                      DateTime @updatedAt

  channelItem ChannelItem @relation(fields: [channelItemId], references: [id], onDelete: Cascade)

  @@unique([channel, channelItemId, channelModifierGroupExternalId])
  @@index([channelItemId])
  @@map("channel_item_modifier_group_links")
}

model ChannelVariant {
  id                 String    @id @default(cuid())
  channel            Channel
  externalId         String
  channelItemId      String
  sku                String?
  referenceVariantId String?
  option1Value       String?
  option2Value       String?
  option3Value       String?
  barcode            String?
  cost               Decimal?  @db.Decimal(10, 2)
  purchaseCost       Decimal?  @db.Decimal(10, 2)
  defaultPricingType String?
  defaultPrice       Decimal?  @db.Decimal(10, 2)
  externalCreatedAt  DateTime?
  externalUpdatedAt  DateTime?
  externalDeletedAt  DateTime?
  rawPayload         Json
  syncedAt           DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  channelItem                ChannelItem                @relation(fields: [channelItemId], references: [id], onDelete: Cascade)
  channelVariantStoreData    ChannelVariantStoreData[]
  itemVariantChannelMappings ItemVariantChannelMapping[]
  channelReceiptLineItems    ChannelReceiptLineItem[]

  @@unique([channel, externalId])
  @@index([channel, externalId])
  @@index([syncedAt])
  @@map("channel_variants")
}

