// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── User & Role ──────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile CustomerProfile?

  @@map("users")
}

// ─── Customer Profile ─────────────────────────────────────────────────────────
// 1:1 extension of User for CUSTOMER-specific data.
// Designed to hold order/subscription/address data in future phases.

model CustomerProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  phone                String?
  preferredPickupNote  String?
  marketingOptIn       Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model DailyRecord {
  id             String   @id @default(cuid())
  date           DateTime @unique
  bagelsBaked    Int
  bagelsLeft     Int
  storeSales     Float
  uberSales      Float
  doordashSales  Float
  otherSales     Float
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  externalFactor DailyExternalFactor?

  @@map("daily_records")
}

model DailyExternalFactor {
  id               String    @id @default(cuid())
  date             DateTime  @unique
  dailyRecordId    String?   @unique
  weatherSummary   String?
  minTemp          Float?
  maxTemp          Float?
  rainMm           Float?
  windKph          Float?
  holidayName      String?
  localEventName   String?
  schoolHoliday    Boolean   @default(false)
  nzNewsSummary    String?
  worldNewsSummary String?
  sourceWeather    String?
  sourceHoliday    String?
  sourceEvents     String?
  sourceNews       String?
  collectedAt      DateTime?
  lastRefreshedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  dailyRecord      DailyRecord? @relation(fields: [dailyRecordId], references: [id], onDelete: SetNull)

  @@index([date])
  @@map("daily_external_factors")
}

model PredictionWeight {
  id          String  @id @default(cuid())
  factorKey   String  @unique
  weightValue Float
  isActive    Boolean @default(true)
  description String?

  @@map("prediction_weights")
}

model AppSetting {
  id                      String   @id @default(cuid())
  shopName                String   @default("Bagels Beyond")
  defaultTargetWasteRatio Float    @default(0.05)
  defaultSafetyBuffer     Float    @default(1.1)
  defaultRegion           String   @default("Canterbury")
  defaultCity             String   @default("Christchurch")
  defaultCountry          String   @default("NZ")
  defaultEventRegion      String   @default("Christchurch")
  autoCollectExternalData Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("app_settings")
}

model SalesPrediction {
  id                       String   @id @default(cuid())
  targetDate               DateTime
  predictedSales           Float
  predictedBagelsSold      Int
  recommendedBagelsToBake  Int
  predictedLeftovers       Int
  confidenceScore          Float?
  method                   String   @default("rule_based_v2")
  notes                    String?
  // Extended fields for advanced prediction
  projectedWasteRate       Float?
  projectedSellThroughRate Float?
  baselineSales            Float?
  baselineBagelsSold       Int?
  adjustmentSummary        String?
  explanationJson          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  factorSnapshots PredictionFactorSnapshot[]

  @@index([targetDate])
  @@map("sales_predictions")
}

model PredictionFactorSnapshot {
  id                 String          @id @default(cuid())
  salesPredictionId  String
  factorKey          String
  factorLabel        String
  factorValue        String
  appliedWeight      Float
  impactScore        Float
  createdAt          DateTime        @default(now())

  salesPrediction    SalesPrediction @relation(fields: [salesPredictionId], references: [id], onDelete: Cascade)

  @@map("prediction_factor_snapshots")
}

model ImportJob {
  id           String   @id @default(cuid())
  fileName     String
  status       String   @default("pending") // pending, validating, ready, imported, failed
  totalRows    Int      @default(0)
  successRows  Int      @default(0)
  failedRows   Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rows ImportRow[]

  @@map("import_jobs")
}

model ImportRow {
  id                   String    @id @default(cuid())
  jobId                String
  rowNumber            Int
  rawJson              String
  parsedDate           DateTime?
  parsedBagelsBaked    Int?
  parsedBagelsLeft     Int?
  parsedStoreSales     Float?
  parsedUberSales      Float?
  parsedDoordashSales  Float?
  parsedOtherSales     Float?
  parsedNotes          String?
  status               String    @default("pending") // pending, valid, invalid, imported, skipped
  validationErrors     String?
  linkedDailyRecordId  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("import_rows")
}

// ─── Background Task Management ───────────────────────────────────────────────

model ScheduledTask {
  id            String    @id @default(cuid())
  taskType      String    // collect_external_factors | generate_prediction
  targetDate    DateTime?
  status        String    @default("pending") // pending | running | success | partial | failed | skipped
  startedAt     DateTime?
  finishedAt    DateTime?
  errorMessage  String?
  resultSummary String?
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  logs          TaskLog[]

  @@index([status])
  @@index([taskType, targetDate])
  @@index([targetDate])
  @@map("scheduled_tasks")
}

model TaskLog {
  id              String        @id @default(cuid())
  scheduledTaskId String
  message         String
  level           String        @default("info") // info | warning | error
  createdAt       DateTime      @default(now())

  task            ScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)

  @@index([scheduledTaskId])
  @@map("task_logs")
}

// ─── Admin Audit Log ──────────────────────────────────────────────────────────
// Records admin actions on user accounts for auditability.
// Extensible for future actions (e.g. password resets, invites).
// Future extension: add a UI in /admin/audit-logs to view these records.
// Future extension: lastLoginAt can be tracked by updating the User model on each login.

model AdminActionLog {
  id            String   @id @default(cuid())
  adminUserId   String   // The ADMIN who performed the action
  targetUserId  String   // The user whose account was affected
  actionType    String   // CHANGE_ROLE | ACTIVATE_USER | DEACTIVATE_USER
  previousValue String   // Previous role or isActive value (stringified)
  newValue      String   // New role or isActive value (stringified)
  createdAt     DateTime @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("admin_action_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 4 – Product / Menu / Inventory / Order Domain (POS-ready)
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ProductCategory {
  BAGEL
  SANDWICH
  SPREAD
  DRINK
  OTHER
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
  DINE_IN
}

enum OrderSource {
  INTERNAL
  SUBSCRIPTION
  POS_IMPORTED
}

enum IntegrationSource {
  LOYVERSE
  SQUARE
  OTHER
}

// ─── Product (master catalogue) ───────────────────────────────────────────────
// Internal master data. All POS-imported items are eventually mapped to a Product.

model Product {
  id                    String          @id @default(cuid())
  name                  String
  slug                  String          @unique
  description           String?
  category              ProductCategory @default(OTHER)
  basePrice             Float
  isActive              Boolean         @default(true)
  isSubscriptionEligible Boolean        @default(false)
  sortOrder             Int             @default(0)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  variants              ProductVariant[]
  optionGroups          ProductOptionGroup[]
  dailyInventory        DailyInventory[]
  orderItems            OrderItem[]
  externalMappings      ExternalProductMap[]

  @@index([isActive])
  @@index([category])
  @@map("products")
}

// ─── ProductVariant ──────────────────────────────────────────────────────────
// Optional size / bundle / bread-choice variants for a Product.

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String
  priceDelta Float    @default(0)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

// ─── ProductOptionGroup ───────────────────────────────────────────────────────
// Groups of selectable options attached to a Product.
// e.g. "Bagel Choice" (min 1, max 1), "Add-ons" (min 0, max 3)

model ProductOptionGroup {
  id         String          @id @default(cuid())
  productId  String
  name       String
  minSelect  Int             @default(0)
  maxSelect  Int             @default(1)
  isRequired Boolean         @default(false)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  options    ProductOption[]

  @@index([productId])
  @@map("product_option_groups")
}

// ─── ProductOption ────────────────────────────────────────────────────────────
// Individual selectable option within a group.
// e.g. "Plain Bagel +$0", "Add Bacon +$2.50"

model ProductOption {
  id             String             @id @default(cuid())
  optionGroupId  String
  name           String
  priceDelta     Float              @default(0)
  isActive       Boolean            @default(true)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  optionGroup    ProductOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@index([optionGroupId])
  @@map("product_options")
}

// ─── DailyInventory ───────────────────────────────────────────────────────────
// Per-product, per-day production & sales inventory.
// Unlike traditional stock, this tracks daily baked/sold/remaining quantities.
// Extension point: reservedQty will be populated by subscription + confirmed orders.
// Extension point: soldQty can be auto-calculated from POS imports or internal orders.
// Relation to DailyRecord: loosely coupled via date; future logic can join them.

model DailyInventory {
  id           String   @id @default(cuid())
  productId    String
  date         DateTime @db.Date
  plannedQty   Int      @default(0)
  bakedQty     Int      @default(0)
  reservedQty  Int      @default(0)
  soldQty      Int      @default(0)
  isSoldOut    Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
  @@map("daily_inventory")
}

// ─── Order ────────────────────────────────────────────────────────────────────
// Shared order structure for internal / subscription / POS-imported orders.
// source field distinguishes the origin; all order flows share this model.

model Order {
  id                    String          @id @default(cuid())
  orderNumber           String          @unique
  userId                String?
  status                OrderStatus     @default(DRAFT)
  paymentStatus         PaymentStatus   @default(UNPAID)
  fulfillmentType       FulfillmentType @default(PICKUP)
  pickupDate            DateTime?       @db.Date
  pickupTimeSlot        String?
  customerNameSnapshot  String?
  customerEmailSnapshot String?
  customerPhoneSnapshot String?
  subtotalAmount        Float           @default(0)
  discountAmount        Float           @default(0)
  totalAmount           Float           @default(0)
  note                  String?
  source                OrderSource     @default(INTERNAL)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  items                 OrderItem[]
  externalMapping       ExternalOrderMap?

  @@index([status])
  @@index([userId])
  @@index([pickupDate])
  @@index([source])
  @@map("orders")
}

// ─── OrderItem ────────────────────────────────────────────────────────────────
// Snapshot of product name/price at time of order to preserve history.

model OrderItem {
  id                   String           @id @default(cuid())
  orderId              String
  productId            String?
  productNameSnapshot  String
  unitPriceSnapshot    Float
  quantity             Int
  lineTotal            Float
  note                 String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  order                Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  options              OrderItemOption[]

  @@index([orderId])
  @@map("order_items")
}

// ─── OrderItemOption ─────────────────────────────────────────────────────────
// Snapshot of selected option name/price at time of order.

model OrderItemOption {
  id                     String    @id @default(cuid())
  orderItemId            String
  optionGroupNameSnapshot String
  optionNameSnapshot     String
  priceDeltaSnapshot     Float     @default(0)
  quantity               Int       @default(1)
  createdAt              DateTime  @default(now())

  orderItem              OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_options")
}

// ─── ExternalProductMap ───────────────────────────────────────────────────────
// Maps an internal Product to an external POS product ID.
// Used during Loyverse / other POS menu sync.

model ExternalProductMap {
  id                String            @id @default(cuid())
  source            IntegrationSource
  externalProductId String
  productId         String
  externalName      String?
  lastSyncedAt      DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([source, externalProductId])
  @@index([productId])
  @@map("external_product_maps")
}

// ─── ExternalOrderMap ────────────────────────────────────────────────────────
// Tracks sync status of an internal Order to an external POS order.

model ExternalOrderMap {
  id              String            @id @default(cuid())
  source          IntegrationSource
  orderId         String            @unique
  externalOrderId String
  syncStatus      String            @default("pending") // pending | synced | failed
  lastSyncedAt    DateTime?
  errorMessage    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([source, externalOrderId])
  @@index([syncStatus])
  @@map("external_order_maps")
}
