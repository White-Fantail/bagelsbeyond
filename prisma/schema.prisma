// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Ingredient / Menu Costing ────────────────────────────────────────────────

enum UnitType {
  G
  KG
  ML
  L
  EA
  PACK
  BOX
}

enum PriceHistorySourceType {
  MANUAL
  CSV_IMPORT
  SYSTEM
  API_SYNC
  SCRAPER_SYNC
}

enum SupplierSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum PriceImportMode {
  INGREDIENT
  SUPPLIER_LINK
}

enum PriceImportRowStatus {
  READY
  WARNING
  ERROR
  SKIPPED
}

enum RecipeItemSourceType {
  INGREDIENT
  PRODUCT
}

// ─── Pricing Target ───────────────────────────────────────────────────────────

enum PricingTargetType {
  COST_PERCENT
  MARGIN_PERCENT
}

enum RecommendedPriceRounding {
  NONE
  NEAREST_0_10
  NEAREST_0_50
  NEAREST_1_00
}

enum SupplierIntegrationType {
  MANUAL
  API
  SCRAPER
  CSV
}

// ─── Freshness Management ─────────────────────────────────────────────────────

enum StorageType {
  FROZEN
  REFRIGERATED
  AMBIENT
}

enum FreshnessLogType {
  MADE
  DISPLAYED
  DISCARDED
  SOLD
}

// ─── Production Planning ──────────────────────────────────────────────────────

enum PlanningRoundingMode {
  NONE
  ROUND_UP
  ROUND_DOWN
  ROUND_NEAREST
}

// ─── Ordering System ──────────────────────────────────────────────────────────

enum CustomerOrderStatus {
  DRAFT
  PENDING
  SENT_TO_LOYVERSE
  FAILED_TO_SEND
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum PickupType {
  ASAP
  SCHEDULED
}

enum PlanningBatchHandlingMode {
  IGNORE
  ROUND_UP
  ROUND_NEAREST
}

enum ForecastOverrideSourceType {
  MANUAL
  SYSTEM
}

enum SupplierSyncMode {
  MANUAL_ONLY
  API_READY
  SCRAPER_READY
  CSV_ONLY
}

enum LoyverseSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

// ─── Menu Products & Recipes ──────────────────────────────────────────────────

model ProductCategory {
  id                 String   @id @default(cuid())
  name               String   @unique
  slug               String   @unique
  loyverseId         String?  @unique
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  isFreshnessManaged Boolean  @default(false)
  freshnessSortOrder Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products MenuProduct[]

  @@index([sortOrder])
  @@index([freshnessSortOrder])
  @@index([isActive])
  @@index([isFreshnessManaged])
  @@map("product_categories")
}

model MenuProduct {
  id                         String               @id @default(cuid())
  name                       String
  sku                        String?              @unique
  loyverseId                 String?              @unique
  isActive                   Boolean              @default(true)
  notes                      String?
  sellingPrice               Decimal?             @db.Decimal(10, 2)
  pricingTargetType          PricingTargetType?
  pricingTargetPercent       Decimal?             @db.Decimal(5, 2)
  canBeUsedAsRecipeComponent Boolean              @default(false)
  categoryId                 String?
  // Freshness Management
  shelfLifeDays              Int?
  storageType                StorageType?
  // Production Planning
  isProductionPlannable      Boolean              @default(false)
  productionBatchSize        Float?
  productionBufferPercent    Float?
  planningRoundingMode       PlanningRoundingMode?
  // Online Ordering
  description                String?
  imageUrl                   String?
  isPopular                  Boolean              @default(false)
  isSoldOut                  Boolean              @default(false)
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  category             ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  freshnessLogs        FreshnessLog[]

  @@index([name])
  @@index([isActive])
  @@index([categoryId])
  @@index([canBeUsedAsRecipeComponent])
  @@index([isProductionPlannable])
  @@map("menu_products")
}

// ─── User & Role ──────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  freshnessLogs          FreshnessLog[]

  @@map("users")
}

// ─── Freshness Management ─────────────────────────────────────────────────────

model FreshnessLog {
  id                String           @id @default(cuid())
  productId         String
  logType           FreshnessLogType
  loggedAt          DateTime
  quantity          Int
  remainingQuantity Int              @default(0)
  notes             String?
  rawDictation      String?
  createdByUserId   String?
  createdAt         DateTime         @default(now())

  product           MenuProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdByUser     User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([logType])
  @@index([loggedAt])
  @@index([createdByUserId])
  @@map("freshness_logs")
}

model DailyRecord {
  id             String   @id @default(cuid())
  date           DateTime @unique
  bagelsBaked    Int
  bagelsLeft     Int
  storeSales     Float
  uberSales      Float
  doordashSales  Float
  otherSales     Float
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("daily_records")
}

