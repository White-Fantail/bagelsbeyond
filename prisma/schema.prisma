// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Ingredient / Menu Costing ────────────────────────────────────────────────

enum UnitType {
  G
  KG
  ML
  L
  EA
  PACK
  BOX
}

model IngredientCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  ingredients Ingredient[]

  @@index([sortOrder])
  @@index([isActive])
  @@map("ingredient_categories")
}

model Ingredient {
  id               String              @id @default(cuid())
  name             String
  categoryId       String?
  description      String?
  purchasePrice    Decimal             @db.Decimal(10, 2)
  purchaseQuantity Decimal             @db.Decimal(10, 3)
  purchaseUnit     UnitType
  baseUnit         UnitType
  yieldPercent     Decimal             @default(100.00) @db.Decimal(5, 2)
  taxIncluded      Boolean             @default(true)
  isActive         Boolean             @default(true)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  category         IngredientCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeItems      RecipeItem[]

  @@index([name])
  @@index([categoryId])
  @@index([isActive])
  @@map("ingredients")
}

// ─── Menu Products & Recipes ──────────────────────────────────────────────────

model MenuProduct {
  id        String   @id @default(cuid())
  name      String
  sku       String?  @unique
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipes   Recipe[]

  @@index([name])
  @@index([isActive])
  @@map("menu_products")
}

model Recipe {
  id        String      @id @default(cuid())
  productId String
  name      String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  product   MenuProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  items     RecipeItem[]

  @@index([productId])
  @@index([productId, isActive])
  @@map("recipes")
}

model RecipeItem {
  id           String   @id @default(cuid())
  recipeId     String
  ingredientId String
  quantity     Decimal  @db.Decimal(10, 3)
  unit         UnitType
  notes        String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
  @@map("recipe_items")
}

// ─── User & Role ──────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model DailyRecord {
  id             String   @id @default(cuid())
  date           DateTime @unique
  bagelsBaked    Int
  bagelsLeft     Int
  storeSales     Float
  uberSales      Float
  doordashSales  Float
  otherSales     Float
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  externalFactor DailyExternalFactor?

  @@map("daily_records")
}

model DailyExternalFactor {
  id               String    @id @default(cuid())
  date             DateTime  @unique
  dailyRecordId    String?   @unique
  weatherSummary   String?
  minTemp          Float?
  maxTemp          Float?
  rainMm           Float?
  windKph          Float?
  holidayName      String?
  localEventName   String?
  schoolHoliday    Boolean   @default(false)
  nzNewsSummary    String?
  worldNewsSummary String?
  sourceWeather    String?
  sourceHoliday    String?
  sourceEvents     String?
  sourceNews       String?
  collectedAt      DateTime?
  lastRefreshedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  dailyRecord      DailyRecord? @relation(fields: [dailyRecordId], references: [id], onDelete: SetNull)

  @@index([date])
  @@map("daily_external_factors")
}

model PredictionWeight {
  id          String  @id @default(cuid())
  factorKey   String  @unique
  weightValue Float
  isActive    Boolean @default(true)
  description String?

  @@map("prediction_weights")
}

// ─── Weight Set Versioning ────────────────────────────────────────────────────

model WeightSet {
  id          String           @id @default(cuid())
  version     Int
  name        String
  description String?
  isActive    Boolean          @default(false)
  source      String           @default("manual") // manual | auto_optimized
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  entries     WeightSetEntry[]

  @@map("weight_sets")
}

model WeightSetEntry {
  id          String     @id @default(cuid())
  weightSetId String
  factorKey   String
  weightValue Float
  isActive    Boolean    @default(true)
  description String?
  createdAt   DateTime   @default(now())

  weightSet   WeightSet  @relation(fields: [weightSetId], references: [id], onDelete: Cascade)

  @@map("weight_set_entries")
}

model AppSetting {
  id                      String   @id @default(cuid())
  shopName                String   @default("Bagels Beyond")
  defaultTargetWasteRatio Float    @default(0.05)
  defaultSafetyBuffer     Float    @default(1.1)
  defaultRegion           String   @default("Canterbury")
  defaultCity             String   @default("Christchurch")
  defaultCountry          String   @default("NZ")
  defaultEventRegion      String   @default("Christchurch")
  autoCollectExternalData Boolean  @default(true)
  predictionLookbackDays  Int      @default(365)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("app_settings")
}

model SalesPrediction {
  id                       String   @id @default(cuid())
  targetDate               DateTime
  predictedSales           Float
  predictedBagelsSold      Int
  recommendedBagelsToBake  Int
  predictedLeftovers       Int
  confidenceScore          Float?
  method                   String   @default("rule_based_v2")
  notes                    String?
  // Extended fields for advanced prediction
  projectedWasteRate       Float?
  projectedSellThroughRate Float?
  baselineSales            Float?
  baselineBagelsSold       Int?
  adjustmentSummary        String?
  explanationJson          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  factorSnapshots PredictionFactorSnapshot[]

  @@index([targetDate])
  @@map("sales_predictions")
}

model PredictionFactorSnapshot {
  id                 String          @id @default(cuid())
  salesPredictionId  String
  factorKey          String
  factorLabel        String
  factorValue        String
  appliedWeight      Float
  impactScore        Float
  createdAt          DateTime        @default(now())

  salesPrediction    SalesPrediction @relation(fields: [salesPredictionId], references: [id], onDelete: Cascade)

  @@map("prediction_factor_snapshots")
}

model ImportJob {
  id           String   @id @default(cuid())
  fileName     String
  status       String   @default("pending") // pending, validating, ready, imported, failed
  totalRows    Int      @default(0)
  successRows  Int      @default(0)
  failedRows   Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rows ImportRow[]

  @@map("import_jobs")
}

model ImportRow {
  id                   String    @id @default(cuid())
  jobId                String
  rowNumber            Int
  rawJson              String
  parsedDate           DateTime?
  parsedBagelsBaked    Int?
  parsedBagelsLeft     Int?
  parsedStoreSales     Float?
  parsedUberSales      Float?
  parsedDoordashSales  Float?
  parsedOtherSales     Float?
  parsedNotes          String?
  status               String    @default("pending") // pending, valid, invalid, imported, skipped
  linkedDailyRecordId  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("import_rows")
}

// ─── Background Task Management ───────────────────────────────────────────────

model ScheduledTask {
  id            String    @id @default(cuid())
  taskType      String    // collect_external_factors | generate_prediction
  targetDate    DateTime?
  status        String    @default("pending") // pending | running | success | partial | failed | skipped
  startedAt     DateTime?
  finishedAt    DateTime?
  errorMessage  String?
  resultSummary String?
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  logs          TaskLog[]

  @@index([status])
  @@index([taskType, targetDate])
  @@index([targetDate])
  @@map("scheduled_tasks")
}

model TaskLog {
  id              String        @id @default(cuid())
  scheduledTaskId String
  message         String
  level           String        @default("info") // info | warning | error
  createdAt       DateTime      @default(now())

  task            ScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)

  @@index([scheduledTaskId])
  @@map("task_logs")
}

// ─── Admin Audit Log ──────────────────────────────────────────────────────────
// Records admin actions on user accounts for auditability.
// Extensible for future actions (e.g. password resets, invites).
// Future extension: add a UI in /admin/audit-logs to view these records.
// Future extension: lastLoginAt can be tracked by updating the User model on each login.

model AdminActionLog {
  id            String   @id @default(cuid())
  adminUserId   String   // The ADMIN who performed the action
  targetUserId  String   // The user whose account was affected
  actionType    String   // CHANGE_ROLE | ACTIVATE_USER | DEACTIVATE_USER
  previousValue String   // Previous role or isActive value (stringified)
  newValue      String   // New role or isActive value (stringified)
  createdAt     DateTime @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("admin_action_logs")
}

