// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Ingredient / Menu Costing ────────────────────────────────────────────────

enum UnitType {
  G
  KG
  ML
  L
  EA
  PACK
  BOX
}

enum PriceHistorySourceType {
  MANUAL
  CSV_IMPORT
  SYSTEM
  API_SYNC
  SCRAPER_SYNC
}

enum SupplierSyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum PriceImportMode {
  INGREDIENT
  SUPPLIER_LINK
}

enum PriceImportRowStatus {
  READY
  WARNING
  ERROR
  SKIPPED
}

enum RecipeItemSourceType {
  INGREDIENT
  PRODUCT
}

// ─── Pricing Target ───────────────────────────────────────────────────────────

enum PricingTargetType {
  COST_PERCENT
  MARGIN_PERCENT
}

enum RecommendedPriceRounding {
  NONE
  NEAREST_0_10
  NEAREST_0_50
  NEAREST_1_00
}

enum SupplierIntegrationType {
  MANUAL
  API
  SCRAPER
  CSV
}

// ─── Freshness Management ─────────────────────────────────────────────────────

enum StorageType {
  FROZEN
  REFRIGERATED
  AMBIENT
}

enum FreshnessLogType {
  MADE
  DISPLAYED
}

// ─── Production Planning ──────────────────────────────────────────────────────

enum PlanningRoundingMode {
  NONE
  ROUND_UP
  ROUND_DOWN
  ROUND_NEAREST
}

enum PlanningBatchHandlingMode {
  IGNORE
  ROUND_UP
  ROUND_NEAREST
}

enum ForecastOverrideSourceType {
  MANUAL
  SYSTEM
}

enum SupplierSyncMode {
  MANUAL_ONLY
  API_READY
  SCRAPER_READY
  CSV_ONLY
}

model IngredientCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  slug        String       @unique
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  ingredients Ingredient[]

  @@index([sortOrder])
  @@index([isActive])
  @@map("ingredient_categories")
}

model Ingredient {
  id               String              @id @default(cuid())
  name             String
  categoryId       String?
  description      String?
  purchasePrice    Decimal             @db.Decimal(10, 2)
  purchaseQuantity Decimal             @db.Decimal(10, 3)
  purchaseUnit     UnitType
  baseUnit         UnitType
  yieldPercent     Decimal             @default(100.00) @db.Decimal(5, 2)
  taxIncluded      Boolean             @default(true)
  isActive         Boolean             @default(true)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  category         IngredientCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipeItems      RecipeItem[]
  priceHistory     IngredientPriceHistory[]
  supplierLinks    IngredientSupplierLink[]

  @@index([name])
  @@index([categoryId])
  @@index([isActive])
  @@map("ingredients")
}

model IngredientPriceHistory {
  id               String                 @id @default(cuid())
  ingredientId     String
  purchasePrice    Decimal                @db.Decimal(10, 2)
  purchaseQuantity Decimal                @db.Decimal(10, 3)
  purchaseUnit     UnitType
  baseUnit         UnitType
  taxIncluded      Boolean
  yieldPercent     Decimal                @db.Decimal(5, 2)
  sourceType       PriceHistorySourceType @default(MANUAL)
  notes            String?
  effectiveFrom    DateTime
  createdAt        DateTime               @default(now())
  createdByUserId  String?

  ingredient       Ingredient             @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  ingredientSupplierLinkId String?
  ingredientSupplierLink   IngredientSupplierLink? @relation(fields: [ingredientSupplierLinkId], references: [id], onDelete: SetNull)

  createdByUser    User?                  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([ingredientId])
  @@index([effectiveFrom])
  @@index([createdAt])
  @@index([sourceType])
  @@index([ingredientSupplierLinkId])
  @@map("ingredient_price_history")
}

model Supplier {
  id              String                    @id @default(cuid())
  name            String                    @unique
  slug            String                    @unique
  integrationType SupplierIntegrationType   @default(MANUAL)
  websiteUrl      String?
  notes           String?
  isActive        Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  ingredientLinks   IngredientSupplierLink[]
  apiCredential     SupplierApiCredential?
  scraperCredential SupplierScraperCredential?
  syncLogs          SupplierSyncLog[]

  @@index([name])
  @@index([slug])
  @@index([isActive])
  @@map("suppliers")
}

model SupplierApiCredential {
  id          String   @id @default(cuid())
  supplierId  String   @unique
  adapterKey  String
  credentials String   // JSON-encoded API credentials (admin-only, never sent to client)
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  syncLogs SupplierSyncLog[]

  @@index([supplierId])
  @@map("supplier_api_credentials")
}

model SupplierScraperCredential {
  id          String   @id @default(cuid())
  supplierId  String   @unique
  adapterKey  String
  credentials String   // JSON-encoded scraper credentials (loginUrl, username, password, etc.)
  isActive    Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  syncLogs SupplierSyncLog[]

  @@index([supplierId])
  @@map("supplier_scraper_credentials")
}

model SupplierSyncLog {
  id                  String             @id @default(cuid())
  supplierId          String
  credentialId        String?
  scraperCredentialId String?
  status              SupplierSyncStatus
  triggeredByUserId   String?
  startedAt           DateTime           @default(now())
  finishedAt          DateTime?
  totalLinks          Int                @default(0)
  successLinks        Int                @default(0)
  errorLinks          Int                @default(0)
  skippedLinks        Int                @default(0)
  errorSummary        String?
  notes               String?
  createdAt           DateTime           @default(now())

  supplier          Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  credential        SupplierApiCredential?     @relation(fields: [credentialId], references: [id], onDelete: SetNull)
  scraperCredential SupplierScraperCredential? @relation(fields: [scraperCredentialId], references: [id], onDelete: SetNull)
  triggeredByUser   User?                      @relation(fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  logEntries        SupplierSyncLogEntry[]

  @@index([supplierId])
  @@index([status])
  @@index([startedAt])
  @@map("supplier_sync_logs")
}

model SupplierSyncLogEntry {
  id                       String          @id @default(cuid())
  syncLogId                String
  ingredientSupplierLinkId String?
  ingredientId             String?
  message                  String
  level                    String          @default("info")
  createdAt                DateTime        @default(now())

  syncLog SupplierSyncLog @relation(fields: [syncLogId], references: [id], onDelete: Cascade)

  @@index([syncLogId])
  @@map("supplier_sync_log_entries")
}

model IngredientSupplierLink {
  id                      String           @id @default(cuid())
  ingredientId            String
  supplierId              String
  supplierProductName     String
  supplierProductCode     String?
  supplierProductUrl      String?
  supplierPackageQuantity Decimal?         @db.Decimal(10, 3)
  supplierPackageUnit     UnitType?
  supplierBaseUnit        UnitType?
  isPrimary               Boolean          @default(false)
  isActive                Boolean          @default(true)
  syncMode                SupplierSyncMode @default(MANUAL_ONLY)
  lastCheckedAt           DateTime?
  lastSyncStatus          String?
  notes                   String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  supplier   Supplier   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  priceHistoryLinks IngredientPriceHistory[]

  @@index([ingredientId])
  @@index([supplierId])
  @@index([isPrimary])
  @@index([isActive])
  @@map("ingredient_supplier_links")
}

model PriceImportBatch {
  id              String                 @id @default(cuid())
  mode            PriceImportMode
  sourceType      PriceHistorySourceType
  fileName        String?
  totalRows       Int                    @default(0)
  successRows     Int                    @default(0)
  errorRows       Int                    @default(0)
  createdAt       DateTime               @default(now())
  createdByUserId String?

  createdByUser   User?                  @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  rows            PriceImportRow[]

  @@index([createdAt])
  @@index([mode])
  @@map("price_import_batches")
}

model PriceImportRow {
  id                       String               @id @default(cuid())
  batchId                  String
  rowNumber                Int
  rawPayload               Json
  status                   PriceImportRowStatus
  ingredientId             String?
  ingredientSupplierLinkId String?
  message                  String?
  createdAt                DateTime             @default(now())

  batch PriceImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([status])
  @@map("price_import_rows")
}

// ─── Menu Products & Recipes ──────────────────────────────────────────────────

model ProductCategory {
  id                 String   @id @default(cuid())
  name               String   @unique
  slug               String   @unique
  sortOrder          Int      @default(0)
  isActive           Boolean  @default(true)
  isFreshnessManaged Boolean  @default(false)
  freshnessSortOrder Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products MenuProduct[]

  @@index([sortOrder])
  @@index([freshnessSortOrder])
  @@index([isActive])
  @@index([isFreshnessManaged])
  @@map("product_categories")
}

model MenuProduct {
  id                         String               @id @default(cuid())
  name                       String
  sku                        String?              @unique
  isActive                   Boolean              @default(true)
  notes                      String?
  sellingPrice               Decimal?             @db.Decimal(10, 2)
  pricingTargetType          PricingTargetType?
  pricingTargetPercent       Decimal?             @db.Decimal(5, 2)
  canBeUsedAsRecipeComponent Boolean              @default(false)
  categoryId                 String?
  // Freshness Management
  shelfLifeDays              Int?
  storageType                StorageType?
  // Production Planning
  isProductionPlannable      Boolean              @default(false)
  productionBatchSize        Float?
  productionBufferPercent    Float?
  planningRoundingMode       PlanningRoundingMode?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt

  category             ProductCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recipes              Recipe[]
  componentRecipeItems RecipeItem[] @relation("ComponentProduct")
  forecastOverrides    ForecastOverride[]
  freshnessLogs        FreshnessLog[]

  @@index([name])
  @@index([isActive])
  @@index([categoryId])
  @@index([canBeUsedAsRecipeComponent])
  @@index([isProductionPlannable])
  @@map("menu_products")
}

model Recipe {
  id             String      @id @default(cuid())
  productId      String
  name           String
  isActive       Boolean     @default(true)
  outputQuantity Decimal     @default(1) @db.Decimal(10, 3)
  outputUnit     UnitType    @default(EA)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  product   MenuProduct  @relation(fields: [productId], references: [id], onDelete: Cascade)
  items     RecipeItem[]

  @@index([productId])
  @@index([productId, isActive])
  @@map("recipes")
}

model RecipeItem {
  id                 String               @id @default(cuid())
  recipeId           String
  sourceType         RecipeItemSourceType @default(INGREDIENT)
  ingredientId       String?
  componentProductId String?
  quantity           Decimal              @db.Decimal(10, 3)
  unit               UnitType
  notes              String?
  sortOrder          Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  recipe           Recipe      @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient       Ingredient? @relation(fields: [ingredientId], references: [id])
  componentProduct MenuProduct? @relation("ComponentProduct", fields: [componentProductId], references: [id])

  @@index([recipeId])
  @@index([ingredientId])
  @@index([componentProductId])
  @@map("recipe_items")
}

// ─── User & Role ──────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredientPriceHistory IngredientPriceHistory[]
  priceImportBatches     PriceImportBatch[]
  supplierSyncLogs       SupplierSyncLog[]
  freshnessLogs          FreshnessLog[]

  @@map("users")
}

// ─── Freshness Management ─────────────────────────────────────────────────────

model FreshnessLog {
  id                String           @id @default(cuid())
  productId         String
  logType           FreshnessLogType
  loggedAt          DateTime
  quantity          Int
  notes             String?
  rawDictation      String?
  createdByUserId   String?
  createdAt         DateTime         @default(now())

  product           MenuProduct      @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdByUser     User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([logType])
  @@index([loggedAt])
  @@index([createdByUserId])
  @@map("freshness_logs")
}

model DailyRecord {
  id             String   @id @default(cuid())
  date           DateTime @unique
  bagelsBaked    Int
  bagelsLeft     Int
  storeSales     Float
  uberSales      Float
  doordashSales  Float
  otherSales     Float
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  externalFactor DailyExternalFactor?

  @@map("daily_records")
}

model DailyExternalFactor {
  id               String    @id @default(cuid())
  date             DateTime  @unique
  dailyRecordId    String?   @unique
  weatherSummary   String?
  minTemp          Float?
  maxTemp          Float?
  rainMm           Float?
  windKph          Float?
  holidayName      String?
  localEventName   String?
  schoolHoliday    Boolean   @default(false)
  nzNewsSummary    String?
  worldNewsSummary String?
  sourceWeather    String?
  sourceHoliday    String?
  sourceEvents     String?
  sourceNews       String?
  collectedAt      DateTime?
  lastRefreshedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  dailyRecord      DailyRecord? @relation(fields: [dailyRecordId], references: [id], onDelete: SetNull)

  @@index([date])
  @@map("daily_external_factors")
}

model PredictionWeight {
  id          String  @id @default(cuid())
  factorKey   String  @unique
  weightValue Float
  isActive    Boolean @default(true)
  description String?

  @@map("prediction_weights")
}

// ─── Weight Set Versioning ────────────────────────────────────────────────────

model WeightSet {
  id          String           @id @default(cuid())
  version     Int
  name        String
  description String?
  isActive    Boolean          @default(false)
  source      String           @default("manual") // manual | auto_optimized
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  entries     WeightSetEntry[]

  @@map("weight_sets")
}

model WeightSetEntry {
  id          String     @id @default(cuid())
  weightSetId String
  factorKey   String
  weightValue Float
  isActive    Boolean    @default(true)
  description String?
  createdAt   DateTime   @default(now())

  weightSet   WeightSet  @relation(fields: [weightSetId], references: [id], onDelete: Cascade)

  @@map("weight_set_entries")
}

model AppSetting {
  id                          String                      @id @default(cuid())
  shopName                    String                      @default("Bagels Beyond")
  defaultTargetWasteRatio     Float                       @default(0.05)
  defaultSafetyBuffer         Float                       @default(1.1)
  defaultRegion               String                      @default("Canterbury")
  defaultCity                 String                      @default("Christchurch")
  defaultCountry              String                      @default("NZ")
  defaultEventRegion          String                      @default("Christchurch")
  autoCollectExternalData     Boolean                     @default(true)
  predictionLookbackDays      Int                         @default(365)
  defaultPricingTargetType    PricingTargetType           @default(COST_PERCENT)
  defaultPricingTargetPercent Decimal                     @default(30.00) @db.Decimal(5, 2)
  defaultPriceRounding        RecommendedPriceRounding    @default(NONE)
  // Production Planning
  planningBufferPercent       Float                       @default(10.0)
  planningRoundingMode        PlanningRoundingMode        @default(ROUND_UP)
  planningBatchHandlingMode   PlanningBatchHandlingMode   @default(ROUND_UP)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  @@map("app_settings")
}

model SalesPrediction {
  id                       String   @id @default(cuid())
  targetDate               DateTime
  predictedSales           Float
  predictedBagelsSold      Int
  recommendedBagelsToBake  Int
  predictedLeftovers       Int
  confidenceScore          Float?
  method                   String   @default("rule_based_v2")
  notes                    String?
  // Extended fields for advanced prediction
  projectedWasteRate       Float?
  projectedSellThroughRate Float?
  baselineSales            Float?
  baselineBagelsSold       Int?
  adjustmentSummary        String?
  explanationJson          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  factorSnapshots PredictionFactorSnapshot[]

  @@index([targetDate])
  @@map("sales_predictions")
}

model PredictionFactorSnapshot {
  id                 String          @id @default(cuid())
  salesPredictionId  String
  factorKey          String
  factorLabel        String
  factorValue        String
  appliedWeight      Float
  impactScore        Float
  createdAt          DateTime        @default(now())

  salesPrediction    SalesPrediction @relation(fields: [salesPredictionId], references: [id], onDelete: Cascade)

  @@map("prediction_factor_snapshots")
}

model ImportJob {
  id           String   @id @default(cuid())
  fileName     String
  status       String   @default("pending") // pending, validating, ready, imported, failed
  totalRows    Int      @default(0)
  successRows  Int      @default(0)
  failedRows   Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rows ImportRow[]

  @@map("import_jobs")
}

model ImportRow {
  id                   String    @id @default(cuid())
  jobId                String
  rowNumber            Int
  rawJson              String
  parsedDate           DateTime?
  parsedBagelsBaked    Int?
  parsedBagelsLeft     Int?
  parsedStoreSales     Float?
  parsedUberSales      Float?
  parsedDoordashSales  Float?
  parsedOtherSales     Float?
  parsedNotes          String?
  status               String    @default("pending") // pending, valid, invalid, imported, skipped
  linkedDailyRecordId  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("import_rows")
}

// ─── Background Task Management ───────────────────────────────────────────────

model ScheduledTask {
  id            String    @id @default(cuid())
  taskType      String    // collect_external_factors | generate_prediction
  targetDate    DateTime?
  status        String    @default("pending") // pending | running | success | partial | failed | skipped
  startedAt     DateTime?
  finishedAt    DateTime?
  errorMessage  String?
  resultSummary String?
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  logs          TaskLog[]

  @@index([status])
  @@index([taskType, targetDate])
  @@index([targetDate])
  @@map("scheduled_tasks")
}

model TaskLog {
  id              String        @id @default(cuid())
  scheduledTaskId String
  message         String
  level           String        @default("info") // info | warning | error
  createdAt       DateTime      @default(now())

  task            ScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)

  @@index([scheduledTaskId])
  @@map("task_logs")
}

// ─── Admin Audit Log ──────────────────────────────────────────────────────────
// Records admin actions on user accounts for auditability.
// Extensible for future actions (e.g. password resets, invites).
// Future extension: add a UI in /admin/audit-logs to view these records.
// Future extension: lastLoginAt can be tracked by updating the User model on each login.

model AdminActionLog {
  id            String   @id @default(cuid())
  adminUserId   String   // The ADMIN who performed the action
  targetUserId  String   // The user whose account was affected
  actionType    String   // CHANGE_ROLE | ACTIVATE_USER | DEACTIVATE_USER
  previousValue String   // Previous role or isActive value (stringified)
  newValue      String   // New role or isActive value (stringified)
  createdAt     DateTime @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("admin_action_logs")
}


// ─── Production Planning ──────────────────────────────────────────────────────

model ForecastOverride {
  id                String                     @id @default(cuid())
  targetDate        DateTime                   @db.Date
  productId         String
  predictedSalesQty Float
  sourceType        ForecastOverrideSourceType @default(MANUAL)
  notes             String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  product MenuProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([targetDate, productId])
  @@index([targetDate])
  @@index([productId])
  @@map("forecast_overrides")
}
