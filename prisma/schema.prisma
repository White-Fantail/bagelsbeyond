// ─── Channel Sales Mirror Tables ──────────────────────────────────────────────

model ChannelReceipt {
  id                 String    @id @default(cuid())
  channel            Channel
  externalId         String?
  storeExternalId    String?
  orderCode          String?
  customerExternalId String?
  source             String?
  receiptDate        DateTime?
  note               String?
  rawPayload         Json
  syncedAt           DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  channelReceiptDiscounts ChannelReceiptDiscount[]
  channelReceiptLineItems ChannelReceiptLineItem[]
  channelReceiptPayments  ChannelReceiptPayment[]

  @@unique([channel, externalId])
  @@index([channel, externalId])
  @@index([receiptDate])
  @@index([syncedAt])
  @@map("channel_receipts")
}

model ChannelReceiptDiscount {
  id                 String   @id @default(cuid())
  channel            Channel
  channelReceiptId   String
  externalDiscountId String?
  percentage         Decimal? @db.Decimal(5, 2)
  moneyAmount        Decimal? @db.Decimal(10, 2)
  scope              String?
  rawPayload         Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  channelReceipt ChannelReceipt @relation(fields: [channelReceiptId], references: [id], onDelete: Cascade)

  @@index([channelReceiptId])
  @@map("channel_receipt_discounts")
}

model ChannelReceiptLineItem {
  id                       String   @id @default(cuid())
  channel                  Channel
  channelReceiptId         String
  channelVariantExternalId String?
  channelVariantId         String?
  quantity                 Decimal  @db.Decimal(10, 4)
  price                    Decimal? @db.Decimal(10, 2)
  cost                     Decimal? @db.Decimal(10, 2)
  lineNote                 String?
  rawPayload               Json
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  channelReceipt                  ChannelReceipt                   @relation(fields: [channelReceiptId], references: [id], onDelete: Cascade)
  channelVariant                  ChannelVariant?                  @relation(fields: [channelVariantId], references: [id], onDelete: SetNull)
  channelReceiptLineItemDiscounts ChannelReceiptLineItemDiscount[]
  channelReceiptLineItemTaxes     ChannelReceiptLineItemTax[]
  channelReceiptLineItemModifiers ChannelReceiptLineItemModifier[]

  @@index([channelReceiptId])
  @@index([channelVariantId])
  @@map("channel_receipt_line_items")
}

model ChannelReceiptLineItemDiscount {
  id                       String   @id @default(cuid())
  channel                  Channel
  channelReceiptLineItemId String
  externalDiscountId       String?
  rawPayload               Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  channelReceiptLineItem ChannelReceiptLineItem @relation(fields: [channelReceiptLineItemId], references: [id], onDelete: Cascade)

  @@index([channelReceiptLineItemId])
  @@map("channel_receipt_line_item_discounts")
}

model ChannelReceiptLineItemTax {
  id                       String   @id @default(cuid())
  channel                  Channel
  channelReceiptLineItemId String
  externalTaxId            String?
  rawPayload               Json?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  channelReceiptLineItem ChannelReceiptLineItem @relation(fields: [channelReceiptLineItemId], references: [id], onDelete: Cascade)

  @@index([channelReceiptLineItemId])
  @@map("channel_receipt_line_item_taxes")
}

model ChannelReceiptLineItemModifier {
  id                              String   @id @default(cuid())
  channel                         Channel
  channelReceiptLineItemId        String
  channelModifierOptionExternalId String?
  channelModifierOptionId         String?
  price                           Decimal? @db.Decimal(10, 2)
  rawPayload                      Json?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  channelReceiptLineItem ChannelReceiptLineItem @relation(fields: [channelReceiptLineItemId], references: [id], onDelete: Cascade)
  channelModifierOption  ChannelModifierOption? @relation(fields: [channelModifierOptionId], references: [id], onDelete: SetNull)

  @@index([channelReceiptLineItemId])
  @@index([channelModifierOptionId])
  @@map("channel_receipt_line_item_modifiers")
}

model ChannelReceiptPayment {
  id                           String    @id @default(cuid())
  channel                      Channel
  channelReceiptId             String
  channelPaymentTypeExternalId String?
  channelPaymentTypeId         String?
  paidAt                       DateTime?
  amount                       Decimal?  @db.Decimal(10, 2)
  rawPayload                   Json
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  channelReceipt     ChannelReceipt      @relation(fields: [channelReceiptId], references: [id], onDelete: Cascade)
  channelPaymentType ChannelPaymentType? @relation(fields: [channelPaymentTypeId], references: [id], onDelete: SetNull)

  @@index([channelReceiptId])
  @@index([channelPaymentTypeId])
  @@map("channel_receipt_payments")
}

// ─── Sync Job Tables ──────────────────────────────────────────────────────────

model SyncJob {
  id           String    @id @default(cuid())
  channel      Channel
  syncType     String
  status       String    @default("PENDING")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  summary      Json?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  logs SyncJobLog[]

  @@index([channel, status])
  @@index([startedAt(sort: Desc)])
  @@map("sync_jobs")
}

model SyncJobLog {
  id               String   @id @default(cuid())
  syncJobId        String
  entityType       String
  entityExternalId String?
  action           String
  status           String
  message          String
  payload          Json?
  createdAt        DateTime @default(now())

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@index([status])
  @@map("sync_job_logs")
}
