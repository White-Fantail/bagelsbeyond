// This is your Prisma schema file

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── User & Role ──────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile         CustomerProfile?
  subscriptions           Subscription[]
  bagelAvailabilityStates BagelAvailabilityState[]

  @@map("users")
}

// ─── Customer Profile ─────────────────────────────────────────────────────────
// 1:1 extension of User for CUSTOMER-specific data.
// Designed to hold order/subscription/address data in future phases.

model CustomerProfile {
  id                   String   @id @default(cuid())
  userId               String   @unique
  phone                String?
  preferredPickupNote  String?
  marketingOptIn       Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model DailyRecord {
  id             String   @id @default(cuid())
  date           DateTime @unique
  bagelsBaked    Int
  bagelsLeft     Int
  storeSales     Float
  uberSales      Float
  doordashSales  Float
  otherSales     Float
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  externalFactor DailyExternalFactor?

  @@map("daily_records")
}

model DailyExternalFactor {
  id               String    @id @default(cuid())
  date             DateTime  @unique
  dailyRecordId    String?   @unique
  weatherSummary   String?
  minTemp          Float?
  maxTemp          Float?
  rainMm           Float?
  windKph          Float?
  holidayName      String?
  localEventName   String?
  schoolHoliday    Boolean   @default(false)
  nzNewsSummary    String?
  worldNewsSummary String?
  sourceWeather    String?
  sourceHoliday    String?
  sourceEvents     String?
  sourceNews       String?
  collectedAt      DateTime?
  lastRefreshedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  dailyRecord      DailyRecord? @relation(fields: [dailyRecordId], references: [id], onDelete: SetNull)

  @@index([date])
  @@map("daily_external_factors")
}

model PredictionWeight {
  id          String  @id @default(cuid())
  factorKey   String  @unique
  weightValue Float
  isActive    Boolean @default(true)
  description String?

  @@map("prediction_weights")
}

model AppSetting {
  id                      String   @id @default(cuid())
  shopName                String   @default("Bagels Beyond")
  defaultTargetWasteRatio Float    @default(0.05)
  defaultSafetyBuffer     Float    @default(1.1)
  defaultRegion           String   @default("Canterbury")
  defaultCity             String   @default("Christchurch")
  defaultCountry          String   @default("NZ")
  defaultEventRegion      String   @default("Christchurch")
  autoCollectExternalData Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("app_settings")
}

model SalesPrediction {
  id                       String   @id @default(cuid())
  targetDate               DateTime
  predictedSales           Float
  predictedBagelsSold      Int
  recommendedBagelsToBake  Int
  predictedLeftovers       Int
  confidenceScore          Float?
  method                   String   @default("rule_based_v2")
  notes                    String?
  // Extended fields for advanced prediction
  projectedWasteRate       Float?
  projectedSellThroughRate Float?
  baselineSales            Float?
  baselineBagelsSold       Int?
  adjustmentSummary        String?
  explanationJson          String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  factorSnapshots PredictionFactorSnapshot[]

  @@index([targetDate])
  @@map("sales_predictions")
}

model PredictionFactorSnapshot {
  id                 String          @id @default(cuid())
  salesPredictionId  String
  factorKey          String
  factorLabel        String
  factorValue        String
  appliedWeight      Float
  impactScore        Float
  createdAt          DateTime        @default(now())

  salesPrediction    SalesPrediction @relation(fields: [salesPredictionId], references: [id], onDelete: Cascade)

  @@map("prediction_factor_snapshots")
}

model ImportJob {
  id           String   @id @default(cuid())
  fileName     String
  status       String   @default("pending") // pending, validating, ready, imported, failed
  totalRows    Int      @default(0)
  successRows  Int      @default(0)
  failedRows   Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rows ImportRow[]

  @@map("import_jobs")
}

model ImportRow {
  id                   String    @id @default(cuid())
  jobId                String
  rowNumber            Int
  rawJson              String
  parsedDate           DateTime?
  parsedBagelsBaked    Int?
  parsedBagelsLeft     Int?
  parsedStoreSales     Float?
  parsedUberSales      Float?
  parsedDoordashSales  Float?
  parsedOtherSales     Float?
  parsedNotes          String?
  status               String    @default("pending") // pending, valid, invalid, imported, skipped
  validationErrors     String?
  linkedDailyRecordId  String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("import_rows")
}

// ─── Background Task Management ───────────────────────────────────────────────

model ScheduledTask {
  id            String    @id @default(cuid())
  taskType      String    // collect_external_factors | generate_prediction
  targetDate    DateTime?
  status        String    @default("pending") // pending | running | success | partial | failed | skipped
  startedAt     DateTime?
  finishedAt    DateTime?
  errorMessage  String?
  resultSummary String?
  retryCount    Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  logs          TaskLog[]

  @@index([status])
  @@index([taskType, targetDate])
  @@index([targetDate])
  @@map("scheduled_tasks")
}

model TaskLog {
  id              String        @id @default(cuid())
  scheduledTaskId String
  message         String
  level           String        @default("info") // info | warning | error
  createdAt       DateTime      @default(now())

  task            ScheduledTask @relation(fields: [scheduledTaskId], references: [id], onDelete: Cascade)

  @@index([scheduledTaskId])
  @@map("task_logs")
}

// ─── Admin Audit Log ──────────────────────────────────────────────────────────
// Records admin actions on user accounts for auditability.
// Extensible for future actions (e.g. password resets, invites).
// Future extension: add a UI in /admin/audit-logs to view these records.
// Future extension: lastLoginAt can be tracked by updating the User model on each login.

model AdminActionLog {
  id            String   @id @default(cuid())
  adminUserId   String   // The ADMIN who performed the action
  targetUserId  String   // The user whose account was affected
  actionType    String   // CHANGE_ROLE | ACTIVATE_USER | DEACTIVATE_USER
  previousValue String   // Previous role or isActive value (stringified)
  newValue      String   // New role or isActive value (stringified)
  createdAt     DateTime @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([createdAt])
  @@map("admin_action_logs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// Phase 4 – Product / Menu / Inventory / Order Domain (POS-ready)
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Enums ────────────────────────────────────────────────────────────────────

// ─── Channel Architecture Enums ───────────────────────────────────────────────
// ChannelType: identifies the external sales channel.
// MappingStatus: tracks whether canonical entity is mapped to a channel entity.
// SyncDirection: indicates the allowed sync direction for a mapped entity.
// ProductStatus: canonical lifecycle status for products.

enum ChannelType {
  LOYVERSE
  UBER_EATS
  DOORDASH
}

enum MappingStatus {
  ACTIVE
  UNMAPPED
  ERROR
  DISABLED
}

enum SyncDirection {
  PULL
  PUSH
  BIDIRECTIONAL
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum OrderStatus {
  DRAFT
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
  DINE_IN
}

enum OrderSource {
  INTERNAL
  SUBSCRIPTION
  POS_IMPORTED
}

enum IntegrationSource {
  LOYVERSE
  SQUARE
  OTHER
}

// ─── Canonical Category ───────────────────────────────────────────────────────
// Source-of-truth category used by Beyond internally.
// Populated by sync from Loyverse (or other channels) via CategoryChannelMapping.
// Do NOT store external IDs here — use the mapping tables.

model Category {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  displayOrder Int      @default(0)
  isVisible    Boolean  @default(true)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products       Product[]
  channelMapping CategoryChannelMapping[]

  @@index([isActive])
  @@index([isVisible])
  @@map("categories")
}

// ─── Product (canonical) ──────────────────────────────────────────────────────
// Beyond-internal master data. All POS-imported items are eventually mapped here.
// Loyverse-owned fields: name, basePrice, structure.
// Beyond-owned fields: soldOut, voiceAlias, notes, display preferences.

// ─── LoyverseCategory ────────────────────────────────────────────────────────
// Mirror of Loyverse categories. Loyverse is the single source of truth.
// Categories are never created locally; they are always synced from Loyverse.
// DEPRECATED: use ChannelCategory + CategoryChannelMapping + Category instead.

model LoyverseCategory {
  id                 String   @id @default(cuid())
  loyverseCategoryId String   @unique
  name               String
  color              String?
  isActive           Boolean  @default(true)
  isVisible          Boolean  @default(true)
  displayOrder       Int      @default(0)
  source             String   @default("LOYVERSE")
  isSynced           Boolean  @default(true)
  isEditable         Boolean  @default(false)
  rawPayload         Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products Product[]

  @@index([isActive])
  @@index([isVisible])
  @@map("loyverse_categories")
}

model Product {
  id                     String          @id @default(cuid())
  name                   String
  slug                   String          @unique
  description            String?
  // Canonical category (Beyond internal). Populated via sync + CategoryChannelMapping.
  categoryId             String?
  // Legacy Loyverse category FK — kept for backward compatibility. Prefer categoryId.
  loyverseCategoryId     String?
  basePrice              Float
  displayOrder           Int             @default(0)
  isVisible              Boolean         @default(true)
  isActive               Boolean         @default(true)
  status                 ProductStatus   @default(ACTIVE)
  imageUrl               String?
  sku                    String?
  trackInventory         Boolean         @default(false)
  // Beyond-owned operational flags — NOT overwritten by Loyverse sync.
  soldOut                Boolean         @default(false)
  voiceAlias             String?
  notes                  String?
  isSubscriptionEligible Boolean         @default(false)
  sortOrder              Int             @default(0)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  category                   Category?                      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  loyverseCategory           LoyverseCategory?              @relation(fields: [loyverseCategoryId], references: [id], onDelete: SetNull)
  variants                   ProductVariant[]
  optionGroups               ProductOptionGroup[]
  // Shared modifier group assignments (many-to-many).
  optionGroupAssignments     ProductOptionGroupAssignment[]
  dailyInventory             DailyInventory[]
  orderItems                 OrderItem[]
  externalMappings           ExternalProductMap[]
  subscriptionItems          SubscriptionItem[]
  channelMapping             ProductChannelMapping[]

  @@index([isActive])
  @@index([categoryId])
  @@index([loyverseCategoryId])
  @@map("products")
}

// ─── ProductVariant ──────────────────────────────────────────────────────────
// Optional size / bundle / bread-choice variants for a Product.

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String
  priceDelta Float    @default(0)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

// ─── ProductOptionGroup (canonical ModifierGroup) ─────────────────────────────
// Canonical modifier group used by Beyond internally.
// Loyverse-synced groups are created here and linked via ModifierGroupChannelMapping.
//
// productId is nullable so that groups can be managed independently from the
// modifier menu before being linked to any product.
//
// Loyverse-synced groups keep productId set to the primary product that was
// originally synced, for backward compatibility.
// See docs/bagel-modifier-policy.md for full rationale.

model ProductOptionGroup {
  id           String          @id @default(cuid())
  productId    String?
  name         String
  description  String?
  minSelect    Int             @default(0)
  maxSelect    Int             @default(1)
  isRequired   Boolean         @default(false)
  displayOrder Int             @default(0)
  isVisible    Boolean         @default(true)
  isActive     Boolean         @default(true)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  product         Product?                        @relation(fields: [productId], references: [id], onDelete: SetNull)
  options         ProductOption[]
  externalMapping ExternalOptionGroupMap?
  // All products that use this modifier group
  assignments     ProductOptionGroupAssignment[]
  channelMapping  ModifierGroupChannelMapping[]

  @@index([productId])
  @@map("product_option_groups")
}

// ─── ProductOption (canonical ModifierOption) ────────────────────────────────
// Individual selectable option within a canonical modifier group.
// e.g. "Plain Bagel +$0", "Add Bacon +$2.50"
//
// tracksInventory: when true, this option is tracked in DailyOptionInventory.
// Bagel choice is managed as modifier, NOT variant. See docs/bagel-modifier-policy.md.
// Beyond-owned: soldOut, voiceAlias. NOT overwritten by Loyverse sync.

model ProductOption {
  id               String             @id @default(cuid())
  optionGroupId    String
  name             String
  description      String?
  priceDelta       Float              @default(0)
  displayOrder     Int                @default(0)
  isActive         Boolean            @default(true)
  // Beyond-owned operational flags — NOT overwritten by Loyverse sync.
  soldOut          Boolean            @default(false)
  voiceAlias       String?
  sortOrder        Int                @default(0)
  sku              String?
  tracksInventory  Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  optionGroup            ProductOptionGroup      @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)
  subscriptionOptions    SubscriptionItemOption[]
  dailyOptionInventory   DailyOptionInventory[]
  // Loyverse modifier mapping for this option (modifier-based, not variant-based).
  // Orders can only be transmitted to Loyverse when a mapping exists here.
  externalOptionMappings ExternalOptionMap[]
  // Back-reference to OrderItemOptions that recorded this option
  orderItemOptions       OrderItemOption[]
  channelMapping         ModifierOptionChannelMapping[]

  @@index([optionGroupId])
  @@map("product_options")
}

// ─── DailyOptionInventory ────────────────────────────────────────────────────
// Per-option, per-day inventory — only for options where tracksInventory = true.
// Mirrors the shape of DailyInventory but targets a specific ProductOption rather
// than a Product.  Use case: "How many Plain bagels do we need tomorrow?"

model DailyOptionInventory {
  id           String        @id @default(cuid())
  optionId     String
  date         DateTime      @db.Date
  plannedQty   Int           @default(0)
  reservedQty  Int           @default(0)
  soldQty      Int           @default(0)
  isSoldOut    Boolean       @default(false)
  note         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  option       ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, date])
  @@index([date])
  @@map("daily_option_inventory")
}

// ─── DailyInventory ───────────────────────────────────────────────────────────
// Per-product, per-day production & sales inventory.
// Unlike traditional stock, this tracks daily baked/sold/remaining quantities.
// Extension point: reservedQty will be populated by subscription + confirmed orders.
// Extension point: soldQty can be auto-calculated from POS imports or internal orders.
// Relation to DailyRecord: loosely coupled via date; future logic can join them.

model DailyInventory {
  id           String   @id @default(cuid())
  productId    String
  date         DateTime @db.Date
  plannedQty   Int      @default(0)
  bakedQty     Int      @default(0)
  reservedQty  Int      @default(0)
  soldQty      Int      @default(0)
  isSoldOut    Boolean  @default(false)
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, date])
  @@index([date])
  @@map("daily_inventory")
}

// ─── Order ────────────────────────────────────────────────────────────────────
// Shared order structure for internal / subscription / POS-imported orders.
// source field distinguishes the origin; all order flows share this model.

model Order {
  id                    String          @id @default(cuid())
  orderNumber           String          @unique
  userId                String?
  status                OrderStatus     @default(DRAFT)
  paymentStatus         PaymentStatus   @default(UNPAID)
  fulfillmentType       FulfillmentType @default(PICKUP)
  pickupDate            DateTime?       @db.Date
  pickupTimeSlot        String?
  customerNameSnapshot  String?
  customerEmailSnapshot String?
  customerPhoneSnapshot String?
  subtotalAmount        Float           @default(0)
  discountAmount        Float           @default(0)
  totalAmount           Float           @default(0)
  note                  String?
  source                OrderSource     @default(INTERNAL)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  items                 OrderItem[]
  externalMapping       ExternalOrderMap?
  subscriptionOccurrence SubscriptionOccurrence?

  @@index([status])
  @@index([userId])
  @@index([pickupDate])
  @@index([source])
  @@map("orders")
}

// ─── OrderItem ────────────────────────────────────────────────────────────────
// Snapshot of product name/price at time of order to preserve history.

model OrderItem {
  id                   String           @id @default(cuid())
  orderId              String
  productId            String?
  productNameSnapshot  String
  unitPriceSnapshot    Float
  quantity             Int
  lineTotal            Float
  note                 String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  order                Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product              Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  options              OrderItemOption[]

  @@index([orderId])
  @@map("order_items")
}

// ─── OrderItemOption ─────────────────────────────────────────────────────────
// Snapshot of selected option name/price at time of order.

model OrderItemOption {
  id                      String         @id @default(cuid())
  orderItemId             String
  // Optional reference to the source ProductOption.
  // Set when created from a real product option; null for ad-hoc or imported options.
  // Used for: Loyverse modifier mapping validation, shared option inventory tracking.
  productOptionId         String?
  optionGroupNameSnapshot String
  optionNameSnapshot      String
  priceDeltaSnapshot      Float          @default(0)
  quantity                Int            @default(1)
  createdAt               DateTime       @default(now())

  orderItem               OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productOption           ProductOption? @relation(fields: [productOptionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([productOptionId])
  @@map("order_item_options")
}

// ─── ExternalProductMap ───────────────────────────────────────────────────────
// Maps an internal Product to an external POS product ID.
// Used during Loyverse / other POS menu sync.

model ExternalProductMap {
  id                String            @id @default(cuid())
  source            IntegrationSource
  externalProductId String
  productId         String
  externalName      String?
  lastSyncedAt      DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([source, externalProductId])
  @@index([productId])
  @@map("external_product_maps")
}

// ─── ExternalOrderMap ────────────────────────────────────────────────────────
// Tracks sync status of an internal Order to an external POS order.
// syncStatus values: pending | success | failed | skipped
// Legacy value "synced" is treated as "success" in code.

model ExternalOrderMap {
  id               String            @id @default(cuid())
  source           IntegrationSource
  orderId          String            @unique
  externalOrderId  String?           // null until successfully pushed
  syncStatus       String            @default("pending") // pending | success | failed | skipped
  lastSyncedAt     DateTime?
  errorMessage     String?
  requestSummary   String?           // JSON summary of what was sent to POS
  responseSummary  String?           // JSON summary of POS response
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([source, externalOrderId])
  @@index([syncStatus])
  @@map("external_order_maps")
}

// ─── ExternalOptionGroupMap ──────────────────────────────────────────────────
// Maps an internal ProductOptionGroup to an external POS modifier group ID.
// Created during catalog sync; enables rename-safe lookup of modifier groups.
// Without this, renaming a group in Loyverse would create a duplicate group on
// the next sync instead of updating the existing one.

model ExternalOptionGroupMap {
  id                      String             @id @default(cuid())
  source                  IntegrationSource
  externalOptionGroupId   String
  optionGroupId           String             @unique
  lastSyncedAt            DateTime?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  optionGroup             ProductOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@unique([source, externalOptionGroupId])
  @@index([optionGroupId])
  @@map("external_option_group_maps")
}

// ─── ExternalOptionMap ────────────────────────────────────────────────────────
// Maps an internal ProductOption to an external POS modifier option ID.
//
// Bagel choice policy:
//   Plain / Sesame / Blueberry / Everything are managed as MODIFIER options,
//   NOT as product variants.  mappingType is always "MODIFIER".
//   Orders cannot be transmitted to Loyverse unless every required option has
//   a row here.  See docs/bagel-modifier-policy.md for full rationale.
//
// Shared inventory: because one modifier option (e.g. "Plain") can be linked
//   to multiple products (Bagel, Sandwich), the reservedQty is tracked at
//   the option level in DailyOptionInventory — not per-product.

model ExternalOptionMap {
  id                String            @id @default(cuid())
  source            IntegrationSource
  productOptionId   String
  externalOptionId  String
  externalName      String?
  externalGroupId   String?
  externalGroupName String?
  // mappingType is always "MODIFIER" — variant-based bagel mapping is not used.
  mappingType       String            @default("MODIFIER")
  lastSyncedAt      DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  option            ProductOption     @relation(fields: [productOptionId], references: [id], onDelete: Cascade)

  @@unique([source, externalOptionId])
  @@unique([source, productOptionId])
  @@index([productOptionId])
  @@map("external_option_maps")
}

// ─── ProductOptionGroupAssignment (canonical ProductModifierGroup) ─────────────
// Join table that allows one ProductOptionGroup (canonical ModifierGroup) to be
// shared across multiple Products. This IS the ProductModifierGroup relation.
//
// Example: "Bagel Type" modifier group can be assigned to both the Bagel product
// and the Sandwich product.  Both products then share the same set of options
// (Plain / Sesame / Blueberry / Everything) and the same DailyOptionInventory rows.
//
// Loyverse sync rebuilds these links from modifier_ids on each item.
// Beyond-owned fields: displayOrder, isRequired overrides.

model ProductOptionGroupAssignment {
  id                 String   @id @default(cuid())
  productId          String
  optionGroupId      String
  displayOrder       Int      @default(0)
  isRequired         Boolean  @default(false)
  minSelectOverride  Int?
  maxSelectOverride  Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionGroup ProductOptionGroup @relation(fields: [optionGroupId], references: [id], onDelete: Cascade)

  @@unique([productId, optionGroupId])
  @@index([productId])
  @@index([optionGroupId])
  @@map("product_option_group_assignments")
}

// ─── Subscription ─────────────────────────────────────────────────────────────

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum OccurrenceStatus {
  SCHEDULED
  ORDER_CREATED
  SKIPPED
  CANCELLED
}

model Subscription {
  id              String             @id @default(cuid())
  userId          String
  status          SubscriptionStatus @default(ACTIVE)
  pickupWeekday   Int
  pickupTimeSlot  String?
  startDate       DateTime           @db.Date
  endDate         DateTime?          @db.Date
  note            String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           SubscriptionItem[]
  occurrences     SubscriptionOccurrence[]

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

model SubscriptionItem {
  id             String       @id @default(cuid())
  subscriptionId String
  productId      String
  quantity       Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  options        SubscriptionItemOption[]

  @@index([subscriptionId])
  @@map("subscription_items")
}

// ─── SubscriptionItemOption ───────────────────────────────────────────────────
// Stores the selected option(s) for each subscription item.
// When a SubscriptionOccurrence generates an Order, these options are copied
// to OrderItemOption snapshots so the historical record is preserved.
//
// Fallback policy for deactivated options:
//   - If an option becomes inactive after subscription creation, the existing
//     SubscriptionItemOption row is retained (for reference) but flagged during
//     occurrence → order conversion so an admin can review.
//   - New subscriptions cannot select an inactive option.

model SubscriptionItemOption {
  id                      String           @id @default(cuid())
  subscriptionItemId      String
  optionId                String
  optionGroupNameSnapshot String
  optionNameSnapshot      String
  priceDeltaSnapshot      Float            @default(0)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  subscriptionItem        SubscriptionItem @relation(fields: [subscriptionItemId], references: [id], onDelete: Cascade)
  option                  ProductOption    @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@index([subscriptionItemId])
  @@index([optionId])
  @@map("subscription_item_options")
}

model SubscriptionOccurrence {
  id             String           @id @default(cuid())
  subscriptionId String
  date           DateTime         @db.Date
  status         OccurrenceStatus @default(SCHEDULED)
  orderId        String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  subscription   Subscription     @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([subscriptionId, date])
  @@index([date])
  @@index([status])
  @@map("subscription_occurrences")
}

// ─── Loyverse Mirror Tables ───────────────────────────────────────────────────
// These tables are a direct mirror of the Loyverse data structure.
// All data is synced from Loyverse as the single source of truth.
// Primary keys are the Loyverse IDs (not internal cuids).

model LoyverseModifier {
  id        String   @id  // Loyverse modifier ID
  name      String
  minSelect Int?
  maxSelect Int?
  required  Boolean  @default(false)
  updatedAt DateTime

  options   LoyverseModifierOption[]
  items     LoyverseItemModifier[]

  @@map("loyverse_modifiers")
}

model LoyverseModifierOption {
  id         String   @id  // Loyverse option ID
  modifierId String
  name       String
  price      Float
  updatedAt  DateTime

  modifier   LoyverseModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@map("loyverse_modifier_options")
}

model LoyverseItem {
  id          String   @id  // Loyverse item ID
  name        String
  description String?
  categoryId  String?       // Raw Loyverse category ID string
  price       Float?
  updatedAt   DateTime

  variants    LoyverseVariant[]
  modifiers   LoyverseItemModifier[]

  @@map("loyverse_items")
}

model LoyverseItemModifier {
  id         String @id @default(cuid())
  itemId     String
  modifierId String

  item       LoyverseItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  modifier   LoyverseModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@unique([itemId, modifierId])
  @@map("loyverse_item_modifiers")
}

model LoyverseVariant {
  id        String   @id  // Loyverse variant_id
  itemId    String
  sku       String?
  price     Float?
  updatedAt DateTime

  item            LoyverseItem             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  inventoryLevels LoyverseInventoryLevel[]

  @@map("loyverse_variants")
}

model LoyverseInventoryLevel {
  id        String   @id @default(cuid())
  variantId String
  inStock   Float?
  updatedAt DateTime

  variant   LoyverseVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId])
  @@map("loyverse_inventory_levels")
}

// ─── LoyverseModifierSyncLog ──────────────────────────────────────────────────
// Records each attempt to sync modifier groups from the Loyverse API.
// The most recent successful entry is used as the cached modifier list in the
// admin Modifier Mapping UI, so the UI does not need to hit the live API on
// every page load.  A "Loyverse 새로고침" action triggers a new sync and writes
// a fresh row here.
//
// status values:
//   "success"  — modifiers fetched and stored in rawGroups
//   "empty"    — API returned 200 but zero modifier groups
//   "failed"   — API or parse error; see errorMessage / errorCode
//
// errorCode: HTTP status from Loyverse (401, 403, 404, 429, 5xx…); null when the
//            error is non-HTTP (network, parse, normalize).

model LoyverseModifierSyncLog {
  id           String   @id @default(cuid())
  syncedAt     DateTime @default(now())
  status       String   // "success" | "empty" | "failed"
  groupCount   Int      @default(0)
  optionCount  Int      @default(0)
  errorMessage String?
  errorCode    Int?
  rawGroups    Json?
  createdAt    DateTime @default(now())

  @@index([syncedAt])
  @@map("loyverse_modifier_sync_logs")
}

// ─── LoyverseFullSyncLog ──────────────────────────────────────────────────────
// Records each full (unified) Loyverse sync run.

model LoyverseFullSyncLog {
  id                    String   @id @default(cuid())
  syncedAt              DateTime @default(now())
  status                String   // "success" | "partial" | "failed"
  categoriesFetched     Int      @default(0)
  categoriesUpserted    Int      @default(0)
  productsFetched       Int      @default(0)
  productsCreated       Int      @default(0)
  productsUpdated       Int      @default(0)
  modifierGroupsFetched Int      @default(0)
  modifierGroupsUpserted Int     @default(0)
  modifierOptionsFetched Int     @default(0)
  modifierOptionsUpserted Int    @default(0)
  categoryLinksUpdated           Int      @default(0)
  modifierLinksUpdated           Int      @default(0)
  staleLinksRemoved              Int      @default(0)
  skippedCount                   Int      @default(0)
  errorCount                     Int      @default(0)
  errorMessage                   String?
  itemModifierLinksAttempted     Int      @default(0)
  itemModifierLinksPersisted     Int      @default(0)
  createdAt                      DateTime @default(now())

  @@index([syncedAt])
  @@map("loyverse_full_sync_logs")
}

// ─── Bagel Type Availability Control ─────────────────────────────────────────

enum BagelChangeSource {
  manual
  voice
  sync
  system
  api

  @@map("bagel_change_source")
}

enum AvailabilityChannel {
  loyverse
  uber_eats
  doordash

  @@map("availability_channel")
}

enum ChannelSyncResult {
  success
  failed
  pending
  skipped

  @@map("channel_sync_result")
}

enum AvailabilityAuditAction {
  turned_on
  turned_off
  retried
  restored

  @@map("availability_audit_action")
}

enum RemoteEntityType {
  item
  option
  modifier_option
  category_item
  unknown

  @@map("remote_entity_type")
}

enum SyncJobStatus {
  pending
  processing
  success
  failed

  @@map("sync_job_status")
}

model BagelType {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilityStates  BagelAvailabilityState[]
  channelSyncStatuses ChannelSyncStatus[]
  channelMappings     ChannelBagelMapping[]
  auditLogs           AvailabilityAuditLog[]
  syncJobs            AvailabilitySyncJob[]

  @@index([code])
  @@index([sortOrder])
  @@map("bagel_types")
}

model BagelAvailabilityState {
  id              String            @id @default(cuid())
  bagelTypeId     String
  isAvailable     Boolean
  changedByUserId String?
  changeSource    BagelChangeSource @default(manual)
  note            String?
  createdAt       DateTime          @default(now())

  bagelType     BagelType @relation(fields: [bagelTypeId], references: [id], onDelete: Cascade)
  changedByUser User?     @relation(fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([bagelTypeId, createdAt(sort: Desc)])
  @@map("bagel_availability_states")
}

model ChannelSyncStatus {
  id                   String              @id @default(cuid())
  bagelTypeId          String
  channel              AvailabilityChannel
  lastAttemptAt        DateTime?
  lastSuccessAt        DateTime?
  lastResult           ChannelSyncResult   @default(pending)
  lastError            String?
  lastKnownRemoteState Boolean?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  bagelType BagelType @relation(fields: [bagelTypeId], references: [id], onDelete: Cascade)

  @@unique([bagelTypeId, channel])
  @@index([bagelTypeId])
  @@map("channel_sync_statuses")
}

model ChannelBagelMapping {
  id               String              @id @default(cuid())
  bagelTypeId      String
  channel          AvailabilityChannel
  remoteEntityType RemoteEntityType    @default(unknown)
  remoteEntityId   String
  remoteMenuId     String?
  remoteStoreId    String?
  metadata         Json?
  isEnabled        Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  bagelType BagelType @relation(fields: [bagelTypeId], references: [id], onDelete: Cascade)

  @@unique([bagelTypeId, channel, remoteEntityId])
  @@index([bagelTypeId, channel])
  @@map("channel_bagel_mappings")
}

model AvailabilityAuditLog {
  id          String                  @id @default(cuid())
  bagelTypeId String
  action      AvailabilityAuditAction
  source      BagelChangeSource
  actorUserId String?
  actorLabel  String?
  details     Json?
  createdAt   DateTime                @default(now())

  bagelType BagelType @relation(fields: [bagelTypeId], references: [id], onDelete: Cascade)

  @@index([bagelTypeId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("availability_audit_logs")
}

model AvailabilitySyncJob {
  id              String              @id @default(cuid())
  bagelTypeId     String
  channel         AvailabilityChannel
  targetState     Boolean
  status          SyncJobStatus       @default(pending)
  retryCount      Int                 @default(0)
  maxRetries      Int                 @default(3)
  nextRetryAt     DateTime?
  lastError       String?
  requestPayload  Json?
  responsePayload Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  bagelType BagelType @relation(fields: [bagelTypeId], references: [id], onDelete: Cascade)

  @@index([status, nextRetryAt])
  @@index([bagelTypeId])
  @@map("availability_sync_jobs")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NEW ARCHITECTURE: Channel Mirror Layer
// These tables store external channel data exactly as received, per channel.
// Source-of-truth mirror: never transform business logic here.
// LOYVERSE is the first channel. Structure is extensible to UBER_EATS, DOORDASH.
// Soft delete: use isDeleted instead of hard delete during sync.
// ═══════════════════════════════════════════════════════════════════════════════

// ─── ChannelCategory ──────────────────────────────────────────────────────────
// Mirrors a category as it exists in an external channel (e.g. Loyverse category).
// rawPayload: full JSON from the external API for debugging / repair.

model ChannelCategory {
  id                  String      @id @default(cuid())
  channel             ChannelType
  externalId          String
  name                String
  description         String?
  displayOrder        Int?
  isVisible           Boolean?
  isActive            Boolean?
  rawPayload          Json
  externalCreatedAt   DateTime?
  externalUpdatedAt   DateTime?
  lastSyncedAt        DateTime
  isDeleted           Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  channelMapping CategoryChannelMapping?

  @@unique([channel, externalId])
  @@index([channel])
  @@index([isDeleted])
  @@map("channel_categories")
}

// ─── ChannelProduct ───────────────────────────────────────────────────────────
// Mirrors a product/item as it exists in an external channel.
// externalCategoryId: raw category ID string from the channel (not internal FK).

model ChannelProduct {
  id                  String      @id @default(cuid())
  channel             ChannelType
  externalId          String
  externalCategoryId  String?
  name                String
  description         String?
  price               Float?
  sku                 String?
  imageUrl            String?
  displayOrder        Int?
  isVisible           Boolean?
  isActive            Boolean?
  rawPayload          Json
  externalCreatedAt   DateTime?
  externalUpdatedAt   DateTime?
  lastSyncedAt        DateTime
  isDeleted           Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  channelMapping         ProductChannelMapping?
  modifierGroupLinks     ChannelProductModifierGroupLink[]

  @@unique([channel, externalId])
  @@index([channel])
  @@index([isDeleted])
  @@map("channel_products")
}

// ─── ChannelModifierGroup ─────────────────────────────────────────────────────
// Mirrors a modifier group as it exists in an external channel.

model ChannelModifierGroup {
  id                  String      @id @default(cuid())
  channel             ChannelType
  externalId          String
  name                String
  description         String?
  minSelect           Int?
  maxSelect           Int?
  rawPayload          Json
  externalCreatedAt   DateTime?
  externalUpdatedAt   DateTime?
  lastSyncedAt        DateTime
  isDeleted           Boolean     @default(false)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  options        ChannelModifierOption[]
  productLinks   ChannelProductModifierGroupLink[]
  channelMapping ModifierGroupChannelMapping?

  @@unique([channel, externalId])
  @@index([channel])
  @@index([isDeleted])
  @@map("channel_modifier_groups")
}

// ─── ChannelModifierOption ────────────────────────────────────────────────────
// Mirrors a modifier option as it exists in an external channel.

model ChannelModifierOption {
  id                   String               @id @default(cuid())
  channel              ChannelType
  externalId           String
  channelModifierGroupId String
  name                 String
  priceDelta           Float                @default(0)
  rawPayload           Json
  externalCreatedAt    DateTime?
  externalUpdatedAt    DateTime?
  lastSyncedAt         DateTime
  isDeleted            Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  channelModifierGroup ChannelModifierGroup         @relation(fields: [channelModifierGroupId], references: [id], onDelete: Cascade)
  channelMapping       ModifierOptionChannelMapping?

  @@unique([channel, externalId])
  @@index([channelModifierGroupId])
  @@index([isDeleted])
  @@map("channel_modifier_options")
}

// ─── ChannelProductModifierGroupLink ─────────────────────────────────────────
// Mirrors the product-to-modifier-group relationship exactly as it comes from
// the external channel. Built from modifier_ids on Loyverse items.
// This is NOT a canonical relation — it reflects the channel structure.

model ChannelProductModifierGroupLink {
  id                     String               @id @default(cuid())
  channel                ChannelType
  channelProductId       String
  channelModifierGroupId String
  displayOrder           Int?
  isRequired             Boolean?
  rawPayload             Json                 @default("{}")
  lastSyncedAt           DateTime
  isDeleted              Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  channelProduct       ChannelProduct       @relation(fields: [channelProductId], references: [id], onDelete: Cascade)
  channelModifierGroup ChannelModifierGroup @relation(fields: [channelModifierGroupId], references: [id], onDelete: Cascade)

  @@unique([channel, channelProductId, channelModifierGroupId])
  @@index([channelProductId])
  @@index([channelModifierGroupId])
  @@map("channel_product_modifier_group_links")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NEW ARCHITECTURE: Mapping Layer
// These tables connect canonical Beyond entities to their channel mirrors.
// RULE: Any external channel API call MUST resolve the external ID through here.
//       Never pass a Beyond internal ID directly to an external channel.
// ═══════════════════════════════════════════════════════════════════════════════

// ─── CategoryChannelMapping ───────────────────────────────────────────────────
// Maps a canonical Category to a channel's mirrored ChannelCategory.

model CategoryChannelMapping {
  id                String        @id @default(cuid())
  categoryId        String
  channel           ChannelType
  channelCategoryId String        @unique
  status            MappingStatus @default(ACTIVE)
  syncDirection     SyncDirection @default(PULL)
  lastMappedAt      DateTime
  lastSyncAt        DateTime?
  lastPushAt        DateTime?
  lastError         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  channelCategory ChannelCategory @relation(fields: [channelCategoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, channel])
  @@index([channel])
  @@map("category_channel_mappings")
}

// ─── ProductChannelMapping ────────────────────────────────────────────────────
// Maps a canonical Product to a channel's mirrored ChannelProduct.
// RULE: Always resolve channelProduct.externalId through this mapping when
//       communicating with an external API. Never use Product.id as external ID.

model ProductChannelMapping {
  id               String        @id @default(cuid())
  productId        String
  channel          ChannelType
  channelProductId String        @unique
  status           MappingStatus @default(ACTIVE)
  syncDirection    SyncDirection @default(PULL)
  lastMappedAt     DateTime
  lastSyncAt       DateTime?
  lastPushAt       DateTime?
  lastError        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  channelProduct ChannelProduct @relation(fields: [channelProductId], references: [id], onDelete: Cascade)

  @@unique([productId, channel])
  @@index([channel])
  @@map("product_channel_mappings")
}

// ─── ModifierGroupChannelMapping ──────────────────────────────────────────────
// Maps a canonical ProductOptionGroup (ModifierGroup) to a channel's mirrored
// ChannelModifierGroup.

model ModifierGroupChannelMapping {
  id                     String               @id @default(cuid())
  modifierGroupId        String
  channel                ChannelType
  channelModifierGroupId String               @unique
  status                 MappingStatus        @default(ACTIVE)
  syncDirection          SyncDirection        @default(PULL)
  lastMappedAt           DateTime
  lastSyncAt             DateTime?
  lastPushAt             DateTime?
  lastError              String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  modifierGroup        ProductOptionGroup   @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)
  channelModifierGroup ChannelModifierGroup @relation(fields: [channelModifierGroupId], references: [id], onDelete: Cascade)

  @@unique([modifierGroupId, channel])
  @@index([channel])
  @@map("modifier_group_channel_mappings")
}

// ─── ModifierOptionChannelMapping ─────────────────────────────────────────────
// Maps a canonical ProductOption (ModifierOption) to a channel's mirrored
// ChannelModifierOption.

model ModifierOptionChannelMapping {
  id                      String                @id @default(cuid())
  modifierOptionId        String
  channel                 ChannelType
  channelModifierOptionId String                @unique
  status                  MappingStatus         @default(ACTIVE)
  syncDirection           SyncDirection         @default(PULL)
  lastMappedAt            DateTime
  lastSyncAt              DateTime?
  lastPushAt              DateTime?
  lastError               String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  modifierOption        ProductOption         @relation(fields: [modifierOptionId], references: [id], onDelete: Cascade)
  channelModifierOption ChannelModifierOption @relation(fields: [channelModifierOptionId], references: [id], onDelete: Cascade)

  @@unique([modifierOptionId, channel])
  @@index([channel])
  @@map("modifier_option_channel_mappings")
}

// ═══════════════════════════════════════════════════════════════════════════════
// NEW ARCHITECTURE: Sync Job Log
// Tracks each sync run for observability and debugging.
// ═══════════════════════════════════════════════════════════════════════════════

model SyncJob {
  id           String      @id @default(cuid())
  channel      ChannelType
  syncType     String      // e.g. "FULL_PULL", "CATEGORY_PULL", "PRODUCT_PUSH"
  status       String      @default("PENDING") // PENDING | RUNNING | SUCCESS | PARTIAL | FAILED
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
  summary      Json?
  errorMessage String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  logs SyncJobLog[]

  @@index([channel, status])
  @@index([startedAt(sort: Desc)])
  @@map("sync_jobs")
}

model SyncJobLog {
  id               String   @id @default(cuid())
  syncJobId        String
  entityType       String   // e.g. "CATEGORY", "PRODUCT", "MODIFIER_GROUP"
  entityExternalId String?
  action           String   // e.g. "UPSERT_MIRROR", "CREATE_CANONICAL", "UPDATE_MAPPING"
  status           String   // "OK" | "SKIPPED" | "ERROR"
  message          String
  payload          Json?
  createdAt        DateTime @default(now())

  syncJob SyncJob @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId])
  @@index([status])
  @@map("sync_job_logs")
}
