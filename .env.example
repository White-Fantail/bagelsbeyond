# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beyond_dev"

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong random secret:  openssl rand -base64 32
SESSION_SECRET=your-random-secret-here-change-me

# Default password used for seeded test accounts (dev only — change before production!)
# SEED_DEFAULT_PASSWORD=Dev@12345!

# ─── External Data Providers ──────────────────────────────────────────────────

# Weather — Open-Meteo (free, no key required)
# No key needed. Override DEFAULT_LATITUDE/LONGITUDE/TIMEZONE for your location.
# WEATHER_PROVIDER=mock   # Set to "mock" to disable real weather calls

# Holiday — Nager.at (free, no key required)
# Set DEFAULT_COUNTRY_CODE to match your country (e.g. NZ, AU, US)
# HOLIDAY_PROVIDER=mock   # Set to "mock" to disable real holiday calls

# News — NewsAPI.org (free developer plan, requires API key)
# Sign up at https://newsapi.org/ to get a free API key
# Without this key, news summaries will be skipped (partial success)
NEWS_API_KEY=

# Events — Placeholder (no API connected yet)
# TODO: Connect to Eventfinda, iTicket, or a local events database
# EVENTFINDA_API_KEY=

# School Holidays — Rule-based (no external API required)
# SCHOOL_HOLIDAY_PROVIDER=mock   # Set to "mock" to use mock provider

# ─── Default Location (used by providers) ─────────────────────────────────────
# Defaults to Christchurch / Canterbury / NZ if not set
# These can also be configured in the app Settings page
DEFAULT_LATITUDE=-43.5321
DEFAULT_LONGITUDE=172.6362
DEFAULT_TIMEZONE=Pacific/Auckland
DEFAULT_REGION=Canterbury
DEFAULT_COUNTRY_CODE=NZ

# ─── Cron / Scheduler ─────────────────────────────────────────────────────────
# Optional: Set a secret to protect the /api/cron/run endpoint
# If set, requests must include "Authorization: Bearer <secret>" header
# CRON_SECRET=your-random-secret-here

# ─── POS Integration — Loyverse ───────────────────────────────────────────────
# Phase 5A: Loyverse catalogue sync
#
# POS_PROVIDER: Set to "LOYVERSE" to enable Loyverse as the active POS.
# POS_PROVIDER=LOYVERSE
#
# LOYVERSE_API_TOKEN: Bearer token from your Loyverse back office.
#   Settings → Integrations → API access → Generate token
#   ⚠ Never commit the real token to source control.
# LOYVERSE_API_TOKEN=
#
# LOYVERSE_API_BASE_URL: Override only if using a proxy or staging endpoint.
# LOYVERSE_API_BASE_URL=https://api.loyverse.com/v1.0
#
# LOYVERSE_MOCK: Set to "true" to use built-in mock data instead of real API.
#   Useful for local development and CI when no token is available.
#   If LOYVERSE_API_TOKEN is absent, mock mode is enabled automatically.
# LOYVERSE_MOCK=true
